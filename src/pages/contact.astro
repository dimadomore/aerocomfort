---
import Base from '../layouts/Base.astro';
import ContactBody from '../components/sections/ContactBody.astro';
import { hvacBusinessLd, breadcrumbLd } from '../lib/schema';
import { localizedPath } from '../i18n/utils';

const locale = 'en' as const;
const title = 'Contact Us | Free AC Quote on the Costa Blanca | Aerocomfort';
const description =
  'Get a free quote for AC installation, repair or servicing on the Costa Blanca. Call, WhatsApp or send a request. We reply within the hour during working hours.';
const crumbs = [
  { name: 'Home', url: localizedPath('/', locale) },
  { name: 'Contact', url: localizedPath('/contact', locale) },
];
---
<Base
  locale={locale}
  path="/contact"
  title={title}
  description={description}
  jsonLd={[hvacBusinessLd(), breadcrumbLd(crumbs)]}
>
  <ContactBody locale={locale} />
</Base>
