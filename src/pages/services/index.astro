---
import Base from '../../layouts/Base.astro';
import ServicesOverview from '../../components/sections/ServicesOverview.astro';
import { hvacBusinessLd, breadcrumbLd } from '../../lib/schema';
import { localizedPath } from '../../i18n/utils';

const locale = 'en' as const;
const title = 'Air Conditioning Services in Costa Blanca | Aerocomfort';
const description =
  'AC installation, repair, maintenance and cleaning across the Costa Blanca. Clear pricing, guarantee, 5.0★ on Google. Get a free quote today.';
const crumbs = [
  { name: 'Home', url: localizedPath('/', locale) },
  { name: 'Services', url: localizedPath('/services', locale) },
];
---
<Base locale={locale} path="/services" title={title} description={description} jsonLd={[hvacBusinessLd(), breadcrumbLd(crumbs)]}>
  <ServicesOverview locale={locale} />
</Base>
