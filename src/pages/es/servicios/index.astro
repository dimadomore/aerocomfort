---
import Base from '../../../layouts/Base.astro';
import ServicesOverview from '../../../components/sections/ServicesOverview.astro';
import { hvacBusinessLd, breadcrumbLd } from '../../../lib/schema';
import { localizedPath } from '../../../i18n/utils';

const locale = 'es' as const;
const title = 'Servicios de Aire Acondicionado en la Costa Blanca | Aerocomfort';
const description =
  'Instalación, reparación, mantenimiento y limpieza de aire acondicionado en la Costa Blanca. Precios claros, garantía y 5,0★. Presupuesto gratis.';
const crumbs = [
  { name: 'Inicio', url: localizedPath('/', locale) },
  { name: 'Servicios', url: localizedPath('/services', locale) },
];
---
<Base locale={locale} path="/services" title={title} description={description} jsonLd={[hvacBusinessLd(), breadcrumbLd(crumbs)]}>
  <ServicesOverview locale={locale} />
</Base>
