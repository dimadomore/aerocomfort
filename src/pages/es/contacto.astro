---
import Base from '../../layouts/Base.astro';
import ContactBody from '../../components/sections/ContactBody.astro';
import { hvacBusinessLd, breadcrumbLd } from '../../lib/schema';
import { localizedPath } from '../../i18n/utils';

const locale = 'es' as const;
const title = 'Contacto Aerocomfort | Presupuesto gratis — Llama o WhatsApp';
const description =
  'Pide presupuesto gratis para instalación, reparación o mantenimiento de aire acondicionado en la Costa Blanca. Llama, escríbenos por WhatsApp o envía tu solicitud.';
const crumbs = [
  { name: 'Inicio', url: localizedPath('/', locale) },
  { name: 'Contacto', url: localizedPath('/contact', locale) },
];
---
<Base
  locale={locale}
  path="/contact"
  title={title}
  description={description}
  jsonLd={[hvacBusinessLd(), breadcrumbLd(crumbs)]}
>
  <ContactBody locale={locale} />
</Base>
