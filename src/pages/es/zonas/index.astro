---
import Base from '../../../layouts/Base.astro';
import AreasHub from '../../../components/sections/AreasHub.astro';
import { hvacBusinessLd, breadcrumbLd } from '../../../lib/schema';
import { localizedPath } from '../../../i18n/utils';

const locale = 'es' as const;
const title = 'Zonas de Servicio: Aire Acondicionado Costa Blanca | Aerocomfort';
const description =
  'Busca tu localidad: instalación, reparación y mantenimiento de aire acondicionado en Torrevieja, Orihuela Costa, Pilar de la Horadada y más de 40 localidades.';
const crumbs = [
  { name: 'Inicio', url: localizedPath('/', locale) },
  { name: 'Zonas', url: localizedPath('/areas', locale) },
];
---
<Base locale={locale} path="/areas" title={title} description={description} jsonLd={[hvacBusinessLd(), breadcrumbLd(crumbs)]}>
  <AreasHub locale={locale} />
</Base>
