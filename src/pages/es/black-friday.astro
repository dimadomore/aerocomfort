---
import Base from '../../layouts/Base.astro';
import PromoBody from '../../components/sections/PromoBody.astro';
import { PROMO } from '../../data/promo';
import { hvacBusinessLd, breadcrumbLd, promoProductLd } from '../../lib/schema';
import { localizedPath } from '../../i18n/utils';

const locale = 'es' as const;
const kw = String(PROMO.kw).replace('.', ',');
const title = `Black Friday: Aire Acondicionado ${PROMO.brand} de ${kw} kW por ${PROMO.price} € | Aerocomfort`;
const description = `${PROMO.brand} ${PROMO.model}, ${kw} kW, clase ${PROMO.energyCool}, Wi-Fi incluido, por ${PROMO.price} €${PROMO.installationIncluded ? ' con instalación básica' : ''} en la Costa Blanca. Oferta limitada: llámanos o escríbenos.`;
const crumbs = [
  { name: 'Inicio', url: localizedPath('/', locale) },
  { name: PROMO.label, url: localizedPath(PROMO.path, locale) },
];
---
<Base
  locale={locale}
  path={PROMO.path}
  title={title}
  description={description}
  image={PROMO.image}
  noindex={!PROMO.active}
  jsonLd={[hvacBusinessLd(), breadcrumbLd(crumbs), ...(PROMO.active ? [promoProductLd(locale)] : [])]}
>
  <PromoBody locale={locale} />
</Base>
