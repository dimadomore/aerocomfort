---
import Base from '../../layouts/Base.astro';
import OffersBody from '../../components/sections/OffersBody.astro';
import { offers } from '../../data';
import { hvacBusinessLd, breadcrumbLd, offerProductsLd } from '../../lib/schema';
import { localizedPath } from '../../i18n/utils';

const locale = 'es' as const;
const title = 'Ofertas de Aire Acondicionado A+++ desde 609 € | Aerocomfort';
const description =
  'Ofertas de temporada en Daikin, Mitsubishi, LG, Panasonic y Giatsu. Eficiencia A+++, suministro e instalación en la Costa Blanca. Presupuesto gratis.';
const crumbs = [
  { name: 'Inicio', url: localizedPath('/', locale) },
  { name: 'Ofertas', url: localizedPath('/offers', locale) },
];

const now = new Date();
const apr30 = new Date(now.getFullYear(), 3, 30);
const year = now <= apr30 ? now.getFullYear() : now.getFullYear() + 1;
const priceValidUntil = `${year}-04-30`;

const jsonLd = [
  hvacBusinessLd(),
  breadcrumbLd(crumbs),
  ...offerProductsLd(offers.items, priceValidUntil, localizedPath('/offers', locale)),
];
---
<Base locale={locale} path="/offers" title={title} description={description} jsonLd={jsonLd}>
  <OffersBody locale={locale} />
</Base>
