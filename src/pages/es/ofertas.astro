---
import Base from '../../layouts/Base.astro';
import OffersBody from '../../components/sections/OffersBody.astro';
import { offers } from '../../data';
import { hvacBusinessLd, breadcrumbLd, offerServicesLd } from '../../lib/schema';
import { localizedPath } from '../../i18n/utils';

const locale = 'es' as const;
const title = 'Ofertas de Aire Acondicionado Instalado desde 609 € | Aerocomfort';
const description =
  'Precios de temporada en equipos inverter Daikin, Mitsubishi, LG, Panasonic y Giatsu, con instalación básica incluida en la Costa Blanca. Pide presupuesto gratis.';
const crumbs = [
  { name: 'Inicio', url: localizedPath('/', locale) },
  { name: 'Ofertas', url: localizedPath('/offers', locale) },
];

const now = new Date();
const apr30 = new Date(now.getFullYear(), 3, 30);
const year = now <= apr30 ? now.getFullYear() : now.getFullYear() + 1;
const priceValidUntil = `${year}-04-30`;
// Season start (1 Oct before that 30 Apr), for Offer validFrom.
const validFrom = `${year - 1}-10-01`;

const jsonLd = [
  hvacBusinessLd(),
  breadcrumbLd(crumbs),
  ...offerServicesLd(offers.items, priceValidUntil, localizedPath('/offers', locale), validFrom),
];
---
<Base locale={locale} path="/offers" title={title} description={description} jsonLd={jsonLd}>
  <OffersBody locale={locale} />
</Base>
