---
import Base from '../../layouts/Base.astro';
import AboutBody from '../../components/sections/AboutBody.astro';
import { hvacBusinessLd, breadcrumbLd } from '../../lib/schema';
import { localizedPath } from '../../i18n/utils';

const locale = 'es' as const;
const title = 'Sobre Nosotros | Equipo de Aire Acondicionado Costa Blanca | Aerocomfort';
const description =
  'Conoce Aerocomfort, un equipo local de aire acondicionado dirigido por Gregorio. Quinto año, más de 1000 instalaciones, 5,0 en Google y 3 años de garantía.';
const crumbs = [
  { name: 'Inicio', url: localizedPath('/', locale) },
  { name: 'Nosotros', url: localizedPath('/about', locale) },
];
---
<Base locale={locale} path="/about" title={title} description={description} jsonLd={[hvacBusinessLd(), breadcrumbLd(crumbs)]}>
  <AboutBody locale={locale} />
</Base>
