---
import { ratingLabel } from '../../data';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/sections/Hero.astro';
import ServicesGrid from '../../components/sections/ServicesGrid.astro';
import WhyUs from '../../components/sections/WhyUs.astro';
import OffersPreview from '../../components/sections/OffersPreview.astro';
import Brands from '../../components/sections/Brands.astro';
import GalleryPreview from '../../components/sections/GalleryPreview.astro';
import Reviews from '../../components/sections/Reviews.astro';
import Areas from '../../components/sections/Areas.astro';
import FaqPreview from '../../components/sections/FaqPreview.astro';
import FinalCta from '../../components/sections/FinalCta.astro';
import { hvacBusinessLd, faqLd, websiteLd, howToLd } from '../../lib/schema';
import { FAQ } from '../../data/faq';

const locale = 'es' as const;
const title = 'Aire Acondicionado Costa Blanca: Instalación y Reparación | Aerocomfort';
const description =
  `Instalación, reparación y mantenimiento de aire acondicionado en Torrevieja, Orihuela Costa y más de 40 localidades. ${ratingLabel('es')} en Google. Respondemos en menos de una hora.`;
const faq = faqLd(FAQ[locale].map((f) => ({ question: f.q, answer: f.a })));
---
<Base
  locale={locale}
  path="/"
  title={title}
  description={description}
  jsonLd={[hvacBusinessLd(), websiteLd(), howToLd(locale), faq]}
>
  <Hero locale={locale} />
  <ServicesGrid locale={locale} />
  <WhyUs locale={locale} />
  <Reviews locale={locale} />
  <OffersPreview locale={locale} />
  <Brands locale={locale} />
  <GalleryPreview locale={locale} />
  <Areas locale={locale} />
  <FaqPreview locale={locale} />
  <FinalCta locale={locale} />
</Base>
