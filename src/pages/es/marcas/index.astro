---
import Base from '../../../layouts/Base.astro';
import BrandsHub from '../../../components/sections/BrandsHub.astro';
import { hvacBusinessLd, breadcrumbLd } from '../../../lib/schema';
import { localizedPath } from '../../../i18n/utils';

const locale = 'es' as const;
const title = 'Marcas de Aire Acondicionado: Mitsubishi, LG, Panasonic… | Aerocomfort';
const description =
  'Instalamos y mantenemos Mitsubishi Electric, LG, Panasonic, Giatsu, Haier, Samsung y Gree en la Costa Blanca, y reparamos todas las marcas principales.';
const crumbs = [
  { name: 'Inicio', url: localizedPath('/', locale) },
  { name: 'Marcas', url: localizedPath('/brands', locale) },
];
---
<Base locale={locale} path="/brands" title={title} description={description} jsonLd={[hvacBusinessLd(), breadcrumbLd(crumbs)]}>
  <BrandsHub locale={locale} />
</Base>
