---
import Base from '../../layouts/Base.astro';
import LegalBody from '../../components/sections/LegalBody.astro';
import { breadcrumbLd } from '../../lib/schema';
import { localizedPath } from '../../i18n/utils';

const locale = 'es' as const;
const path = '/legal';
const navLabel = 'Aviso legal';
const updatedLabel = `Última actualización: ${new Date().toISOString().slice(0, 10)}`;
const crumbs = [
  { name: 'Inicio', url: localizedPath('/', locale) },
  { name: navLabel, url: localizedPath(path, locale) },
];
---
<Base locale={locale} path={path} title="Aviso Legal — Aerocomfort" description="Aviso legal del sitio web de Aerocomfort." jsonLd={[breadcrumbLd(crumbs)]}>
  <LegalBody locale={locale} doc="legal" navLabel={navLabel} updatedLabel={updatedLabel} />
</Base>
