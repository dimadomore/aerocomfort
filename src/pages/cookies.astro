---
import Base from '../layouts/Base.astro';
import { LEGAL_UPDATED } from '../data/legal';
import LegalBody from '../components/sections/LegalBody.astro';
import { breadcrumbLd } from '../lib/schema';
import { localizedPath } from '../i18n/utils';

const locale = 'en' as const;
const path = '/cookies';
const navLabel = 'Cookies';
const updatedLabel = `Last updated: ${LEGAL_UPDATED}`;
const crumbs = [
  { name: 'Home', url: localizedPath('/', locale) },
  { name: navLabel, url: localizedPath(path, locale) },
];
---
<Base locale={locale} path={path} title="Cookie Policy — Aerocomfort" description="How Aerocomfort uses cookies on this website." jsonLd={[breadcrumbLd(crumbs)]}>
  <LegalBody locale={locale} doc="cookies" navLabel={navLabel} updatedLabel={updatedLabel} />
</Base>
