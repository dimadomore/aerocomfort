---
import Base from '../layouts/Base.astro';
import GalleryBody from '../components/sections/GalleryBody.astro';
import { hvacBusinessLd, breadcrumbLd, imageGalleryLd } from '../lib/schema';
import { localizedPath } from '../i18n/utils';
import { galleryPhotos } from '../data';

const locale = 'en' as const;
const title = 'Our Work: AC Installation Photos | Aerocomfort';
const description =
  'Photos of real air conditioning jobs by our team across the Costa Blanca: split and multi-split systems on rooftops, terraces and in homes.';
const crumbs = [
  { name: 'Home', url: localizedPath('/', locale) },
  { name: 'Gallery', url: localizedPath('/gallery', locale) },
];
const jsonLd = [
  hvacBusinessLd(),
  breadcrumbLd(crumbs),
  imageGalleryLd(
    galleryPhotos.map((p) => ({ src: p.src, caption: p.alt[locale] })),
    '/gallery',
    'Aerocomfort — recent installations',
  ),
];
---
<Base locale={locale} path="/gallery" title={title} description={description} jsonLd={jsonLd}>
  <GalleryBody locale={locale} />
</Base>
