---
import Base from '../../layouts/Base.astro';
import AreasHub from '../../components/sections/AreasHub.astro';
import { hvacBusinessLd, breadcrumbLd } from '../../lib/schema';
import { localizedPath } from '../../i18n/utils';

const locale = 'en' as const;
const title = 'Air Conditioning Service Areas — Costa Blanca | Aerocomfort';
const description =
  'AC installation, repair & maintenance across the Costa Blanca & Costa Cálida — Torrevieja, Orihuela Costa, the Mar Menor and 45+ towns. Free quote.';
const crumbs = [
  { name: 'Home', url: localizedPath('/', locale) },
  { name: 'Areas', url: localizedPath('/areas', locale) },
];
---
<Base locale={locale} path="/areas" title={title} description={description} jsonLd={[hvacBusinessLd(), breadcrumbLd(crumbs)]}>
  <AreasHub locale={locale} />
</Base>
