---
import { ratingLabel } from '../data';
import Base from '../layouts/Base.astro';
import AboutBody from '../components/sections/AboutBody.astro';
import { hvacBusinessLd, breadcrumbLd } from '../lib/schema';
import { localizedPath } from '../i18n/utils';

const locale = 'en' as const;
const title = 'About Us | Air Conditioning Team on the Costa Blanca | Aerocomfort';
const description =
  `Meet Aerocomfort, a local air conditioning team on the Costa Blanca. In our fifth year, 1000+ installations, rated ${ratingLabel('en')} on Google, 3-year guarantee.`;
const crumbs = [
  { name: 'Home', url: localizedPath('/', locale) },
  { name: 'About', url: localizedPath('/about', locale) },
];
---
<Base locale={locale} path="/about" title={title} description={description} jsonLd={[hvacBusinessLd(), breadcrumbLd(crumbs)]}>
  <AboutBody locale={locale} />
</Base>
