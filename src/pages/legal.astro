---
import Base from '../layouts/Base.astro';
import LegalBody from '../components/sections/LegalBody.astro';
import { breadcrumbLd } from '../lib/schema';
import { localizedPath } from '../i18n/utils';

const locale = 'en' as const;
const path = '/legal';
const navLabel = 'Legal notice';
const updatedLabel = `Last updated: ${new Date().toISOString().slice(0, 10)}`;
const crumbs = [
  { name: 'Home', url: localizedPath('/', locale) },
  { name: navLabel, url: localizedPath(path, locale) },
];
---
<Base locale={locale} path={path} title="Legal Notice — Aerocomfort" description="Legal notice for the Aerocomfort website." jsonLd={[breadcrumbLd(crumbs)]}>
  <LegalBody locale={locale} doc="legal" navLabel={navLabel} updatedLabel={updatedLabel} />
</Base>
