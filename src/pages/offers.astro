---
import Base from '../layouts/Base.astro';
import OffersBody from '../components/sections/OffersBody.astro';
import { offers } from '../data';
import { hvacBusinessLd, breadcrumbLd, offerProductsLd } from '../lib/schema';
import { localizedPath } from '../i18n/utils';

const locale = 'en' as const;
const title = 'Air Conditioning Offers: A+++ Units from €609 | Aerocomfort';
const description =
  'Season prices on A+++ Daikin, Mitsubishi, LG, Panasonic and Giatsu units, with professional installation across the Costa Blanca. Ask for a free quote.';
const crumbs = [
  { name: 'Home', url: localizedPath('/', locale) },
  { name: 'Offers', url: localizedPath('/offers', locale) },
];

// Season end (1 Oct – 30 Apr): next 30 Apr, for Offer priceValidUntil.
const now = new Date();
const apr30 = new Date(now.getFullYear(), 3, 30);
const year = now <= apr30 ? now.getFullYear() : now.getFullYear() + 1;
const priceValidUntil = `${year}-04-30`;

const jsonLd = [
  hvacBusinessLd(),
  breadcrumbLd(crumbs),
  ...offerProductsLd(offers.items, priceValidUntil, '/offers'),
];
---
<Base locale={locale} path="/offers" title={title} description={description} jsonLd={jsonLd}>
  <OffersBody locale={locale} />
</Base>
