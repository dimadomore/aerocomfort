---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import TrustBar from '../components/sections/TrustBar.astro';
import { hvacBusinessLd } from '../lib/schema';

const locale = 'en' as const;
const title = 'Air Conditioning in Costa Blanca | Install, Repair & Service — Aerocomfort';
const description =
  'Trusted AC installation, repair & maintenance across Torrevieja, Orihuela Costa & 30+ areas. 5.0★ on Google. Free quote — call or WhatsApp.';
---
<Base locale={locale} path="/" title={title} description={description} jsonLd={[hvacBusinessLd()]}>
  <Hero locale={locale} />
  <TrustBar locale={locale} />
</Base>
