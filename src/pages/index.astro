---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import ServicesGrid from '../components/sections/ServicesGrid.astro';
import WhyUs from '../components/sections/WhyUs.astro';
import OffersPreview from '../components/sections/OffersPreview.astro';
import Brands from '../components/sections/Brands.astro';
import GalleryPreview from '../components/sections/GalleryPreview.astro';
import Reviews from '../components/sections/Reviews.astro';
import Areas from '../components/sections/Areas.astro';
import FaqPreview from '../components/sections/FaqPreview.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import { hvacBusinessLd, faqLd, websiteLd, howToLd } from '../lib/schema';
import { FAQ } from '../data/faq';

const locale = 'en' as const;
const title = 'Air Conditioning Costa Blanca: Install & Repair | Aerocomfort';
const description =
  'AC installation, repair and servicing across Torrevieja, Orihuela Costa and 40+ towns. Rated 5.0 on Google. We reply within the hour during working hours.';
const faq = faqLd(FAQ[locale].map((f) => ({ question: f.q, answer: f.a })));
---
<Base
  locale={locale}
  path="/"
  title={title}
  description={description}
  jsonLd={[hvacBusinessLd(), websiteLd(), howToLd(locale), faq]}
>
  <Hero locale={locale} />
  <ServicesGrid locale={locale} />
  <WhyUs locale={locale} />
  <Reviews locale={locale} />
  <OffersPreview locale={locale} />
  <Brands locale={locale} />
  <GalleryPreview locale={locale} />
  <Areas locale={locale} />
  <FaqPreview locale={locale} />
  <FinalCta locale={locale} />
</Base>
