---
import Base from '../../layouts/Base.astro';
import BrandsHub from '../../components/sections/BrandsHub.astro';
import { hvacBusinessLd, breadcrumbLd } from '../../lib/schema';
import { localizedPath } from '../../i18n/utils';

const locale = 'en' as const;
const title = 'Air Conditioning Brands: Mitsubishi, LG, Panasonic… | Aerocomfort';
const description =
  'We install and service Mitsubishi Electric, LG, Panasonic, Giatsu, Haier, Samsung and Gree across the Costa Blanca, and repair all major brands.';
const crumbs = [
  { name: 'Home', url: localizedPath('/', locale) },
  { name: 'Brands', url: localizedPath('/brands', locale) },
];
---
<Base locale={locale} path="/brands" title={title} description={description} jsonLd={[hvacBusinessLd(), breadcrumbLd(crumbs)]}>
  <BrandsHub locale={locale} />
</Base>
