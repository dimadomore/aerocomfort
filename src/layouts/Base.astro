---
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource-variable/inter';
import '../styles/global.css';
import { type Locale } from '../config';
import { useTranslations } from '../i18n/utils';
import Seo from '../components/seo/Seo.astro';
import Analytics from '../components/analytics/Analytics.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import ChatLauncher from '../components/islands/ChatLauncher.astro';
import StickyMobileBar from '../components/islands/StickyMobileBar.astro';
import CookieConsent from '../components/islands/CookieConsent.astro';

interface Props {
  locale: Locale;
  /** EN canonical route key — drives canonical + hreflang + active nav. */
  path: string;
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}
const { locale, path, title, description, image, noindex, jsonLd } = Astro.props;
const t = useTranslations(locale);
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1c62b8" />
    <Seo
      path={path}
      locale={locale}
      title={title}
      description={description}
      image={image}
      noindex={noindex}
      jsonLd={jsonLd}
    />
    <Analytics />
  </head>
  <body class="flex min-h-screen flex-col bg-surface">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:font-semibold focus:text-ink-900 focus:shadow-lg"
    >
      {t('common.skipToContent')}
    </a>
    <Header locale={locale} path={path} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <ChatLauncher locale={locale} />
    <StickyMobileBar locale={locale} />
    <CookieConsent locale={locale} />
  </body>
</html>
