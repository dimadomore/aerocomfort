---
import { type Locale } from '../../config';
import { SERVICES } from '../../data/services';
import { useTranslations, localizedPath } from '../../i18n/utils';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import PageHero from './PageHero.astro';
import WhyUs from './WhyUs.astro';
import FinalCta from './FinalCta.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const es = locale === 'es';

const crumbs = [
  { label: t('breadcrumb.home'), href: localizedPath('/', locale) },
  { label: t('nav.services') },
];
---
<PageHero
  crumbs={crumbs}
  title={es ? 'Servicios de aire acondicionado en la Costa Blanca' : 'Air conditioning services on the Costa Blanca'}
  intro={es
    ? 'Instalación, reparación, mantenimiento y limpieza, con un mismo equipo local de principio a fin.'
    : 'Installation, repair, maintenance and cleaning, from one local team, start to finish.'}
/>

<section class="py-16 lg:py-24">
  <Container class="space-y-14 lg:space-y-20">
    {SERVICES.map((s, i) => (
      <article class="grid gap-6 lg:grid-cols-12 lg:items-center lg:gap-16">
        <a
          class:list={['group block aspect-[4/3] overflow-hidden rounded-md lg:col-span-6', i % 2 === 1 && 'lg:order-2']}
          href={localizedPath(`/services/${s.slug}`, locale)}
          tabindex="-1"
          aria-hidden="true"
        >
          <img class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105" src={s.image} alt="" width="900" height="1200" loading="lazy" decoding="async" />
        </a>
        <div class="lg:col-span-6">
          <h2 class="text-h2">{s[locale].title}</h2>
          <p class="mt-3 text-body text-ink-700">{s[locale].intro}</p>
          <ul class="mt-5 border-t border-line">
            {s[locale].includes.slice(0, 3).map((item) => (
              <li class="border-b border-line py-2.5 text-small text-ink-700">{item}</li>
            ))}
          </ul>
          <a class="mt-5 inline-flex items-center gap-2 text-small font-bold text-brand-700 transition-all hover:gap-3" href={localizedPath(`/services/${s.slug}`, locale)}>
            {es ? `Ver ${s[locale].title.toLowerCase()}` : `See ${s[locale].title.toLowerCase()}`}
            <Icon name="arrow-right" size={18} />
          </a>
        </div>
      </article>
    ))}
  </Container>
</section>

<WhyUs locale={locale} />
<FinalCta locale={locale} />
