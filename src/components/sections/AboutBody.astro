---
import { type Locale } from '../../config';
import { business, reviewCountDisplay } from '../../data';
import { useTranslations, localizedPath } from '../../i18n/utils';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import Prose from '../ui/Prose.astro';
import PageHero from './PageHero.astro';
import WhyUs from './WhyUs.astro';
import FinalCta from './FinalCta.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const es = locale === 'es';
const contactHref = localizedPath('/contact', locale);

const crumbs = [
  { label: t('breadcrumb.home'), href: localizedPath('/', locale) },
  { label: t('nav.about') },
];

// Real owner facts (John, 2026-06-14).
const tr = business.trust;
const stats = [
  { value: tr?.installs ?? '1000+', label: es ? 'instalaciones' : 'installations' },
  { value: `${business.rating.value}★`, label: es ? `${reviewCountDisplay} reseñas` : `${reviewCountDisplay} reviews` },
  { value: es ? `${tr?.guaranteeYears ?? 3} años` : `${tr?.guaranteeYears ?? 3}-yr`, label: es ? 'de garantía' : 'guarantee' },
  { value: `${business.areasCount}+`, label: es ? 'zonas' : 'areas' },
];
---
<PageHero
  crumbs={crumbs}
  eyebrow={es ? 'Nosotros' : 'About'}
  title={es ? 'Sobre Aerocomfort' : 'About Aerocomfort'}
  intro={es
    ? 'Un mismo profesional de confianza detrás de cada trabajo — con la valoración de los clientes que lo respalda.'
    : 'One trusted specialist behind every job — with the customer rating to back it up.'}
/>

<section class="py-16 lg:py-24">
  <Container>
    <div class="grid gap-10 lg:grid-cols-3 lg:gap-12">
      <div class="lg:col-span-2">
        <Prose>
          {es ? (
            <Fragment>
              <p>Aerocomfort es el trabajo de Gregorio, el especialista detrás de cada servicio. Ya en nuestro <strong>quinto año</strong> y con más de <strong>1000 instalaciones</strong> de aire acondicionado en la Costa Blanca y la Costa Cálida, ha conseguido una valoración de <strong>5,0★ en Google</strong> de {reviewCountDisplay} clientes.</p>
              <p>Cada trabajo se hace en persona — sin subcontratas ni centralitas. Tratas directamente con quien realiza el trabajo, desde el primer presupuesto hasta la última prueba.</p>
              <p>Estamos <strong>cualificados para la manipulación de gases fluorados</strong> y respaldamos cada instalación con <strong>3 años de garantía</strong>, más la garantía del fabricante de 3 años sobre el equipo.</p>
              <p>Instalamos, reparamos, limpiamos y mantenemos todas las marcas principales, y también montamos bombas de calor (aerotermia) y ventilación. Pago con tarjeta, transferencia, Bizum o efectivo. Trabajamos en español e inglés, de Torrevieja y Orihuela Costa al Mar Menor y Mazarrón.</p>
            </Fragment>
          ) : (
            <Fragment>
              <p>Aerocomfort is run by Gregorio, the specialist behind every job. Now in our <strong>fifth year</strong>, with <strong>1000+ air conditioning installations</strong> across the Costa Blanca and Costa Cálida, he has earned a <strong>5.0★ rating on Google</strong> from {reviewCountDisplay} customers.</p>
              <p>Every job is done personally — no subcontractors, no call centre. You deal directly with the person who does the work, from the first quote to the final test.</p>
              <p>We are <strong>certified for refrigerant handling (gases fluorados)</strong> and back every installation with a <strong>3-year guarantee</strong>, plus the manufacturer's 3-year warranty on the equipment.</p>
              <p>We install, repair, clean and service all major brands, and also fit heat pumps (aerotermia) and ventilation. Pay by card, transfer, Bizum or cash. We work in English and Spanish, from Torrevieja and Orihuela Costa to the Mar Menor and Mazarrón.</p>
            </Fragment>
          )}
        </Prose>
      </div>

      <aside class="lg:col-span-1">
        <div class="rounded-xl bg-surface-cool p-6 ring-1 ring-line sm:p-8">
          <dl class="grid grid-cols-2 gap-6">
            {stats.map((s) => (
              <div>
                <dt class:list={['font-display text-h2 font-extrabold tabular-nums', s.pending ? 'text-ink-400' : 'text-brand-700']}>{s.value}</dt>
                <dd class="mt-1 text-small text-ink-500">{s.label}</dd>
              </div>
            ))}
          </dl>
          <div class="mt-7">
            <Button href={contactHref} variant="primary" size="lg" class="cta-attention w-full">
              {t('cta.quote')}
              <Icon name="arrow-right" size={20} />
            </Button>
          </div>
        </div>
      </aside>
    </div>
  </Container>
</section>

<WhyUs locale={locale} />
<FinalCta locale={locale} />
