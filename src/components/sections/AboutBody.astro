---
import { type Locale } from '../../config';
import { business, ratingLabel, reviewCountDisplay } from '../../data';
import { useTranslations, localizedPath } from '../../i18n/utils';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import Prose from '../ui/Prose.astro';
import PageHero from './PageHero.astro';
import WhyUs from './WhyUs.astro';
import FinalCta from './FinalCta.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const es = locale === 'es';
const contactHref = localizedPath('/contact', locale);

const crumbs = [
  { label: t('breadcrumb.home'), href: localizedPath('/', locale) },
  { label: t('nav.about') },
];

// Real owner facts (John, 2026-06-14).
const tr = business.trust;
const stats = [
  { value: tr?.installs ?? '1000+', label: es ? 'instalaciones' : 'installations' },
  { value: `${ratingLabel(locale)}★`, label: es ? `${reviewCountDisplay} reseñas` : `${reviewCountDisplay} reviews` },
  { value: es ? `${tr?.guaranteeYears ?? 3} años` : `${tr?.guaranteeYears ?? 3}-yr`, label: es ? 'de garantía' : 'guarantee' },
  { value: `${business.areasCount}+`, label: es ? 'zonas' : 'areas' },
];
---
<PageHero
  crumbs={crumbs}
  image="/gallery/work-01.webp"
  title={es ? 'Sobre Aerocomfort' : 'About Aerocomfort'}
  intro={es
    ? `Un equipo local de aire acondicionado en la Costa Blanca, en nuestro quinto año y con ${ratingLabel('es')} en Google.`
    : `A local air conditioning team on the Costa Blanca, in our fifth year and rated ${ratingLabel('en')} on Google.`}
/>

<section class="py-16 lg:py-24">
  <Container>
    <div class="grid gap-10 lg:grid-cols-3 lg:gap-12">
      <div class="lg:col-span-2">
        <div class="mb-9 flex items-center gap-5">
          {/* Monogram stands in for the owner's portrait until the photo arrives (DIM-286). */}
          <span class="flex h-20 w-20 shrink-0 items-center justify-center rounded-md bg-brand-900 font-display text-4xl font-extrabold text-white" aria-hidden="true">G</span>
          <div>
            <p class="font-display text-h3 font-extrabold text-brand-900">Gregorio</p>
            <p class="mt-0.5 text-small text-ink-700">
              {es ? 'Fundador y responsable del equipo.' : 'Founder and head of the team.'}
            </p>
          </div>
        </div>

        <Prose>
          {es ? (
            <Fragment>
              <p>Aerocomfort es un equipo local de especialistas en aire acondicionado dirigido por Gregorio. Ya en nuestro <strong>quinto año</strong> y con más de <strong>1000 instalaciones</strong> en la Costa Blanca, tenemos una valoración de <strong>{ratingLabel('es')}★ en Google</strong> de {reviewCountDisplay} clientes.</p>
              <p>Gregorio trabaja a pie de obra junto al equipo de especialistas, desde la primera visita hasta la última prueba. Siempre sabes con quién hablas y quién responde del trabajo.</p>
              <p>Estamos <strong>cualificados para la manipulación de gases fluorados</strong> y respaldamos cada instalación con <strong>3 años de garantía</strong>, más la garantía del fabricante de 3 años sobre el equipo.</p>
              <p>Instalamos, reparamos, limpiamos y mantenemos todas las marcas principales, y también montamos bombas de calor (aerotermia) y ventilación. Trabajamos con viviendas, restaurantes y pequeños negocios, en español e inglés, de Torrevieja y Orihuela Costa a Pilar de la Horadada y Guardamar.</p>
            </Fragment>
          ) : (
            <Fragment>
              <p>Aerocomfort is a local team of air conditioning specialists led by Gregorio. Now in our <strong>fifth year</strong>, with <strong>1000+ installations</strong> across the Costa Blanca, we have earned a <strong>{ratingLabel('en')}★ rating on Google</strong> from {reviewCountDisplay} customers.</p>
              <p>Gregorio works on site alongside the team of specialists, from the first visit to the final test. You always know who you are talking to and who is responsible for the job.</p>
              <p>We are <strong>certified for refrigerant handling (gases fluorados)</strong> and back every installation with a <strong>3-year guarantee</strong>, plus the manufacturer's 3-year warranty on the equipment.</p>
              <p>We install, repair, clean and service all major brands, and also fit heat pumps (aerotermia) and ventilation. We work with homes, restaurants and small businesses, in English and Spanish, from Torrevieja and Orihuela Costa to Pilar de la Horadada and Guardamar.</p>
            </Fragment>
          )}
        </Prose>
      </div>

      <aside class="lg:col-span-1">
        <div class="lg:sticky lg:top-24">
          <dl class="border-t border-line">
            {stats.map((s) => (
              <div class="flex items-baseline justify-between gap-4 border-b border-line py-3.5">
                <dt class="text-small text-ink-700 first-letter:uppercase">{s.label}</dt>
                <dd class="font-display text-h3 font-extrabold tabular-nums text-brand-900">{s.value}</dd>
              </div>
            ))}
          </dl>
          <div class="mt-6">
            <Button href={contactHref} variant="primary" size="lg" class="w-full">
              {t('cta.quote')}
              <Icon name="arrow-right" size={20} />
            </Button>
          </div>
        </div>
      </aside>
    </div>
  </Container>
</section>

<WhyUs locale={locale} />
<FinalCta locale={locale} />
