---
import { type Locale } from '../../config';
import { useTranslations, localizedPath } from '../../i18n/utils';
import { business, isPlaceholder, ratingLabel, reviewCountDisplay } from '../../data';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import PageHero from './PageHero.astro';
import LeadForm from '../islands/LeadForm.astro';
import AreaMap from './AreaMap.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const telHref = `tel:+${business.phoneE164.replace(/\D/g, '')}`;
const waHref = `https://wa.me/${business.whatsapp.replace(/\D/g, '')}?text=${encodeURIComponent(business.whatsappMessage[locale])}`;
const mailHref = `mailto:${business.email}`;
const hasHours = !isPlaceholder(business.hours);
const areaWord = locale === 'es' ? 'zonas' : 'areas';

const crumbs = [
  { label: t('breadcrumb.home'), href: localizedPath('/', locale) },
  { label: t('nav.contact') },
];
---
<PageHero crumbs={crumbs} title={t('contact.title')} intro={t('contact.intro')} />

<Container class="grid gap-10 py-12 lg:grid-cols-12 lg:gap-16 lg:py-16">
  <div class="lg:col-span-7">
    <h2 class="text-h2">{t('contact.formTitle')}</h2>
    <div class="mt-6">
      <LeadForm locale={locale} />
    </div>
  </div>

  <aside class="lg:col-span-5" data-cta="contact-panel">
    <div class="rounded-md bg-brand-900 p-6 text-white sm:p-8 lg:sticky lg:top-24">
      <h2 class="text-h3 text-white">{t('contact.channelsTitle')}</h2>
      <a class="mt-4 block font-display text-h2 font-extrabold text-white no-underline hover:underline" href={telHref}>{business.phone}</a>
      <div class="mt-5">
        <Button href={waHref} variant="whatsapp" size="lg" class="w-full" target="_blank" rel="noopener">
          <Icon name="whatsapp" size={20} />
          {t('cta.whatsapp')}
        </Button>
      </div>

      <dl class="mt-7 border-t border-white/15 text-small">
        <div class="border-b border-white/15 py-3">
          <dt class="sr-only">Email</dt>
          <dd><a class="text-white no-underline hover:underline" href={mailHref}>{business.email}</a></dd>
        </div>
        <div class="border-b border-white/15 py-3">
          <dt class="font-semibold">{t('contact.areasLabel')}</dt>
          <dd class="text-white/85">{t('site.region')} · {business.areasCount}+ {areaWord}</dd>
        </div>
        {hasHours && (
          <div class="border-b border-white/15 py-3">
            <dt class="font-semibold">{t('common.openingHours')}</dt>
            <dd class="text-white/85">{business.hours}</dd>
          </div>
        )}
        <div class="flex items-center gap-2 py-3">
          <Icon name="star" size={18} class="text-warning" />
          <span class="font-semibold">{ratingLabel(locale)} {locale === 'es' ? 'en' : 'on'} Google</span>
          <span class="text-white/85">· {reviewCountDisplay} {locale === 'es' ? 'reseñas' : 'reviews'}</span>
        </div>
      </dl>
    </div>
  </aside>
</Container>

<Container class="pb-12 lg:pb-16">
  <h2 class="text-h2">{locale === 'es' ? 'Dónde estamos' : 'Where to find us'}</h2>
  <p class="mt-3 max-w-2xl text-body text-ink-700">
    {locale === 'es'
      ? `Tenemos la base en ${business.addressLocality} y nos desplazamos por toda la Costa Blanca.`
      : `We are based in ${business.addressLocality} and travel across the Costa Blanca.`}
  </p>
  <AreaMap locale={locale} class="mt-8" />
</Container>
