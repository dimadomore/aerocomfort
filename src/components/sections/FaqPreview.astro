---
import { type Locale } from '../../config';
import { FAQ } from '../../data/faq';
import { useTranslations, localizedPath } from '../../i18n/utils';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const es = locale === 'es';
const items = FAQ[locale];
---
<section class="py-16 lg:py-24">
  <Container class="max-w-3xl">
    <SectionHeading align="center" eyebrow="FAQ" title={es ? 'Preguntas frecuentes' : 'Frequent questions'} />
    <div class="mt-10 divide-y divide-line border-y border-line">
      {items.map((f) => (
        <details class="faq">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-body-lg font-semibold text-ink-900">
            {f.q}
            <Icon name="chevron-down" size={22} class="faq__chev shrink-0 text-brand-700 transition-transform" />
          </summary>
          <p class="pb-5 text-body text-ink-500">{f.a}</p>
        </details>
      ))}
    </div>
    <div class="mt-8 text-center">
      <a
        class="inline-flex items-center gap-2 text-small font-bold text-brand-700 transition-all hover:gap-3"
        href={localizedPath('/faq', locale)}
      >
        {t('cta.allFaqs')}
        <Icon name="arrow-right" size={18} />
      </a>
    </div>
  </Container>
</section>

<style>
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq[open] .faq__chev {
    transform: rotate(180deg);
  }
</style>
