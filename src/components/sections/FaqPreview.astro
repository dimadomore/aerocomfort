---
import { type Locale } from '../../config';
import { FAQ } from '../../data/faq';
import { useTranslations, localizedPath } from '../../i18n/utils';
import Container from '../ui/Container.astro';
import MoreLink from '../ui/MoreLink.astro';
import FaqList from '../ui/FaqList.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const es = locale === 'es';
---
<section class="py-16 lg:py-24">
  <Container class="grid gap-8 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4">
      <h2 class="text-h2">{es ? 'Antes de llamar' : 'Before you call'}</h2>
      <MoreLink href={localizedPath('/faq', locale)} class="mt-5">{t('cta.allFaqs')}</MoreLink>
    </div>
    <div class="lg:col-span-8">
      <FaqList items={FAQ[locale]} />
    </div>
  </Container>
</section>
