---
import { type Locale } from '../../config';
import { FAQ } from '../../data/faq';
import { useTranslations, localizedPath } from '../../i18n/utils';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import FaqList from '../ui/FaqList.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const es = locale === 'es';
---
<section class="py-16 lg:py-24">
  <Container class="grid gap-8 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4">
      <h2 class="text-h2">{es ? 'Antes de llamar' : 'Before you call'}</h2>
      <a class="mt-5 inline-flex items-center gap-2 text-small font-bold text-brand-700 transition-all hover:gap-3" href={localizedPath('/faq', locale)}>
        {t('cta.allFaqs')}
        <Icon name="arrow-right" size={18} />
      </a>
    </div>
    <div class="lg:col-span-8">
      <FaqList items={FAQ[locale]} />
    </div>
  </Container>
</section>
