---
import { type Locale } from '../../config';
import { offers } from '../../data';
import { useTranslations, localizedPath } from '../../i18n/utils';
import Container from '../ui/Container.astro';
import PageHero from './PageHero.astro';
import OfferCard from '../ui/OfferCard.astro';
import FinalCta from './FinalCta.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const es = locale === 'es';

const crumbs = [
  { label: t('breadcrumb.home'), href: localizedPath('/', locale) },
  { label: t('nav.offers') },
];
const intro = es
  ? `Equipos inverter de marcas líderes, con la instalación básica incluida y a precio de temporada. ${offers.season.label.es}.`
  : `Inverter units from leading brands, with basic installation included, at seasonal prices. ${offers.season.label.en}.`;
---
<PageHero
  crumbs={crumbs}
  title={es ? 'Ofertas de aire acondicionado con instalación' : 'Air conditioning offers, installation included'}
  intro={intro}
/>

<section class="py-16 lg:py-24">
  <Container>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {offers.items.map((o) => <OfferCard offer={o} locale={locale} />)}
    </div>
    <p class="mt-8 max-w-2xl text-small text-ink-700">
      {es
        ? 'Los precios incluyen la instalación básica, con hasta 3 metros de tubería. Tu presupuesto gratuito confirma el precio final para tu vivienda.'
        : 'Prices include basic installation, with up to 3 metres of pipework. Your free quote confirms the final price for your home.'}
    </p>
  </Container>
</section>

<FinalCta locale={locale} />
