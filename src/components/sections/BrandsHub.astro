---
import { type Locale } from '../../config';
import { BRANDS } from '../../data/brands';
import { useTranslations, localizedPath } from '../../i18n/utils';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import PageHero from './PageHero.astro';
import FinalCta from './FinalCta.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const es = locale === 'es';
const crumbs = [
  { label: t('breadcrumb.home'), href: localizedPath('/', locale) },
  { label: es ? 'Marcas' : 'Brands' },
];
---
<PageHero
  crumbs={crumbs}
  title={es ? 'Marcas de aire acondicionado que instalamos y reparamos' : 'Air conditioning brands we install & service'}
  intro={es
    ? 'Trabajamos con las marcas líderes y te ayudamos a elegir la adecuada para tu espacio y presupuesto.'
    : 'We work with the leading brands and help you choose the right one for your space and budget.'}
/>

<section class="py-16 lg:py-24">
  <Container>
    <div class="border-t border-line">
      {BRANDS.map((b) => (
        <a
          href={localizedPath(`/brands/${b.slug}`, locale)}
          class="group grid items-center gap-3 border-b border-line py-6 no-underline sm:grid-cols-[10rem_minmax(0,1fr)_auto] sm:gap-8"
        >
          <img src={b.logo} alt="" height="32" width="120" class:list={['w-auto max-w-40 object-contain object-left', b.slug === 'lg' ? 'h-11' : 'h-8']} loading="lazy" decoding="async" />
          <span>
            <span class="block font-display text-h3 font-extrabold text-brand-900">{b.name}</span>
            <span class="mt-1 block max-w-2xl text-small text-ink-700">{b[locale].intro}</span>
          </span>
          <Icon name="arrow-right" size={22} class="hidden text-brand-900 transition-transform duration-200 ease-out group-hover:translate-x-1 sm:block" />
        </a>
      ))}
    </div>
  </Container>
</section>

<FinalCta locale={locale} />
