---
import Container from '../ui/Container.astro';
import Breadcrumbs from '../ui/Breadcrumbs.astro';

/** Inner-page header: the same navy + real-photo language as the home hero. */
interface Props {
  crumbs: { label: string; href?: string }[];
  title: string;
  intro?: string;
  /** Real job photo, faded into the navy on the right. */
  image?: string;
}
const { crumbs, title, intro, image } = Astro.props;
---
<section class="page-hero bg-brand-900 text-white" data-cta="page-header">
  {image && <img class="page-hero__img" src={image} alt="" width="900" height="1200" fetchpriority="high" decoding="async" />}
  <Container class="relative py-10 lg:py-14">
    <Breadcrumbs items={crumbs} />
    <div class="mt-6 max-w-xl">
      <h1 class="text-h1 text-white">{title}</h1>
      {intro && <p class="mt-4 text-body-lg text-white/90">{intro}</p>}
      {/* Shown from desktop up. On phones and tablets the bottom bar and the closing
          call-to-action block carry these buttons, so the header stays short. */}
      {Astro.slots.has('cta') && (
        <div class="page-hero__cta">
          <slot name="cta" />
        </div>
      )}
    </div>
  </Container>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  /* Phones: a quiet texture behind the text. Desktop: the right half, faded in. */
  .page-hero__img {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.18;
  }
  .page-hero__cta {
    display: none;
  }
  @media (min-width: 1024px) {
    .page-hero__cta {
      display: block;
    }
    .page-hero__img {
      left: 48%;
      width: 52%;
      opacity: 1;
      filter: saturate(1.15) brightness(1.05);
      mask-image: linear-gradient(90deg, transparent 0%, #000 42%);
    }
  }
</style>
