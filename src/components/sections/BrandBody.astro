---
import { type Locale } from '../../config';
import { BRANDS, type Brand } from '../../data/brands';
import { SERVICES } from '../../data/services';
import { offers, business } from '../../data';
import { useTranslations, localizedPath } from '../../i18n/utils';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import OfferCard from '../ui/OfferCard.astro';
import ServiceRow from '../ui/ServiceRow.astro';
import PageHero from './PageHero.astro';
import FinalCta from './FinalCta.astro';

interface Props {
  locale: Locale;
  brand: Brand;
}
const { locale, brand } = Astro.props;
const t = useTranslations(locale);
const es = locale === 'es';
const c = brand[locale];

const waHref = `https://wa.me/${business.whatsapp.replace(/\D/g, '')}?text=${encodeURIComponent(business.whatsappMessage[locale])}`;
const contactHref = localizedPath('/contact', locale);
const brandOffers = offers.items.filter((o) => o.brand === brand.name);
const others = BRANDS.filter((b) => b.slug !== brand.slug);
const h1 = es ? `Aire acondicionado ${brand.name}, instalación y servicio` : `${brand.name} air conditioning, install & service`;
const crumbs = [
  { label: t('breadcrumb.home'), href: localizedPath('/', locale) },
  { label: es ? 'Marcas' : 'Brands', href: localizedPath('/brands', locale) },
  { label: brand.name },
];
---
<PageHero crumbs={crumbs} title={h1} intro={c.intro}>
  <div slot="cta" class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
    <Button href={contactHref} variant="primary" size="lg">
      {t('cta.quote')}
      <Icon name="arrow-right" size={20} />
    </Button>
    <Button href={waHref} variant="whatsapp" size="lg" target="_blank" rel="noopener">
      <Icon name="whatsapp" size={20} />
      {t('cta.whatsapp')}
    </Button>
  </div>
</PageHero>

<section class="py-16 lg:py-24">
  <Container>
    <div class="grid gap-12 lg:grid-cols-3 lg:gap-16">
      <div class="lg:col-span-2">
        <img
          src={brand.logo}
          alt={brand.name}
          height="44"
          class="mb-8 h-11 w-auto max-w-[55%] object-contain object-left"
          loading="lazy"
          decoding="async"
        />
        <h2 class="text-h2">{es ? `Por qué ${brand.name}` : `Why ${brand.name}`}</h2>
        <p class="mt-4 text-body text-ink-700">{c.why}</p>

        <h2 class="mt-10 text-h3">{es ? 'Lo que hacemos' : 'What we do'}</h2>
        <div class="mt-4 border-t border-line">
          {SERVICES.map((s) => <ServiceRow service={s} locale={locale} />)}
        </div>
      </div>

      {brandOffers.length > 0 && (
        <aside class="lg:col-span-1">
          <h2 class="text-h3">{es ? 'En oferta' : 'On offer'}</h2>
          <div class="mt-4 space-y-5">
            {brandOffers.map((o) => <OfferCard offer={o} locale={locale} />)}
          </div>
        </aside>
      )}
    </div>
  </Container>
</section>

<section class="bg-surface-cool py-14">
  <Container>
    <h2 class="text-h3">{es ? 'Otras marcas' : 'Other brands'}</h2>
    <div class="mt-5 flex flex-wrap gap-2.5">
      {others.map((b) => (
        <a
          class="inline-flex items-center min-h-11 rounded-[4px] border border-brand-900/20 bg-white px-4 text-small font-semibold text-brand-900 no-underline transition-colors hover:border-brand-900"
          href={localizedPath(`/brands/${b.slug}`, locale)}
        >
          {b.name}
        </a>
      ))}
    </div>
  </Container>
</section>

<FinalCta locale={locale} />
