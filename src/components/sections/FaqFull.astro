---
import { type Locale } from '../../config';
import { FAQ_GROUPS } from '../../data/faq';
import { useTranslations, localizedPath } from '../../i18n/utils';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import PageHero from './PageHero.astro';
import FinalCta from './FinalCta.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const es = locale === 'es';
const groups = FAQ_GROUPS[locale];

const crumbs = [
  { label: t('breadcrumb.home'), href: localizedPath('/', locale) },
  { label: t('nav.faq') },
];
---
<PageHero
  crumbs={crumbs}
  eyebrow="FAQ"
  title={es ? 'Preguntas frecuentes' : 'Frequent questions'}
  intro={es
    ? 'Respuestas rápidas sobre instalación, reparación, precios y garantía. ¿Te queda alguna duda? Escríbenos por WhatsApp.'
    : 'Quick answers on installation, repair, pricing and guarantee. Still have a question? Just message us on WhatsApp.'}
/>

<section class="py-16 lg:py-24">
  <Container class="max-w-3xl">
    <div class="space-y-12">
      {groups.map((group) => (
        <div>
          <h2 class="text-h3 text-brand-700">{group.title}</h2>
          <div class="mt-4 divide-y divide-line border-y border-line">
            {group.items.map((f) => (
              <details class="faq">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-body-lg font-semibold text-ink-900 transition-colors hover:text-brand-700">
                  {f.q}
                  <span class="faq__chev flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-sky-100 text-brand-700 transition-transform">
                    <Icon name="chevron-down" size={20} />
                  </span>
                </summary>
                <p class="pb-5 text-body text-ink-500">{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      ))}
    </div>
  </Container>
</section>

<FinalCta locale={locale} />

<style>
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq[open] .faq__chev {
    transform: rotate(180deg);
  }
</style>
