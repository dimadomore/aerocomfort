---
import { type Locale } from '../../config';
import { FAQ_GROUPS } from '../../data/faq';
import { useTranslations, localizedPath } from '../../i18n/utils';
import Container from '../ui/Container.astro';
import FaqList from '../ui/FaqList.astro';
import PageHero from './PageHero.astro';
import FinalCta from './FinalCta.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const es = locale === 'es';
const groups = FAQ_GROUPS[locale];

const crumbs = [
  { label: t('breadcrumb.home'), href: localizedPath('/', locale) },
  { label: t('nav.faq') },
];
---
<PageHero
  crumbs={crumbs}
  title={es ? 'Preguntas frecuentes' : 'Frequent questions'}
  intro={es
    ? 'Respuestas rápidas sobre instalación, reparación, precios y garantía. ¿Te queda alguna duda? Escríbenos por WhatsApp.'
    : 'Quick answers on installation, repair, pricing and guarantee. Still have a question? Just message us on WhatsApp.'}
/>

<section class="py-16 lg:py-24">
  <Container class="space-y-14">
    {groups.map((group) => (
      <div class="grid gap-5 lg:grid-cols-12 lg:gap-16">
        <h2 class="text-h3 lg:col-span-4">{group.title}</h2>
        <div class="lg:col-span-8">
          <FaqList items={group.items} />
        </div>
      </div>
    ))}
  </Container>
</section>

<FinalCta locale={locale} />
