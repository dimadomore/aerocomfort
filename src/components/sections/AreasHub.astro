---
import { type Locale } from '../../config';
import { useTranslations, localizedPath } from '../../i18n/utils';
import Container from '../ui/Container.astro';
import AreaFinder from '../ui/AreaFinder.astro';
import PageHero from './PageHero.astro';
import AreaMap from './AreaMap.astro';
import FinalCta from './FinalCta.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const es = locale === 'es';
const crumbs = [
  { label: t('breadcrumb.home'), href: localizedPath('/', locale) },
  { label: t('nav.areas') },
];
---
<PageHero
  crumbs={crumbs}
  title={es ? 'Aire acondicionado en la Costa Blanca' : 'Air conditioning across the Costa Blanca'}
  intro={es
    ? 'Trabajamos en Torrevieja, Orihuela Costa, Pilar de la Horadada, Guardamar y más de 40 localidades. Elige tu zona para ver los detalles.'
    : 'We work across Torrevieja, Orihuela Costa, Pilar de la Horadada, Guardamar and 40+ towns. Choose your area for details.'}
/>

<section class="py-16 lg:py-24">
  <Container>
    <AreaFinder locale={locale} />
    <AreaMap locale={locale} class="mt-14" />
  </Container>
</section>

<FinalCta locale={locale} />
