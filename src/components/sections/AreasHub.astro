---
import { type Locale } from '../../config';
import { AREAS } from '../../data/areas';
import { business } from '../../data';
import { useTranslations, localizedPath } from '../../i18n/utils';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import PageHero from './PageHero.astro';
import FinalCta from './FinalCta.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const es = locale === 'es';
const crumbs = [
  { label: t('breadcrumb.home'), href: localizedPath('/', locale) },
  { label: t('nav.areas') },
];
---
<PageHero
  crumbs={crumbs}
  eyebrow={es ? 'Zonas de servicio' : 'Service areas'}
  title={es ? 'Aire acondicionado en toda la Costa Blanca' : 'Air conditioning across the Costa Blanca'}
  intro={es
    ? 'Trabajamos en Torrevieja, Orihuela Costa, Alicante y más de 30 localidades. Elige tu zona para ver los detalles.'
    : 'We work across Torrevieja, Orihuela Costa, Alicante and 30+ towns. Choose your area for details.'}
/>

<section class="py-16 lg:py-24">
  <Container>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {AREAS.map((a) => (
        <a
          href={localizedPath(`/areas/${a.slug}`, locale)}
          class="group rounded-xl border border-line bg-white p-6 shadow-sm transition-all hover:-translate-y-1 hover:border-blue-300 hover:shadow-md"
        >
          <span class="flex h-11 w-11 items-center justify-center rounded-lg bg-sky-100 text-brand-700">
            <Icon name="map-pin" size={22} />
          </span>
          <h2 class="mt-4 text-h3">{a[locale].name}</h2>
          <p class="mt-2 text-small text-ink-500">{a[locale].intro}</p>
          <span class="mt-3 inline-flex items-center gap-1.5 text-small font-bold text-brand-700">
            {es ? 'Ver zona' : 'View area'}
            <Icon name="arrow-right" size={16} />
          </span>
        </a>
      ))}
    </div>
    <p class="mt-8 text-small text-ink-500">
      {es
        ? `Y más de ${business.areasCount} localidades en la Costa Blanca. ¿No ves tu zona? Pregúntanos por WhatsApp.`
        : `And ${business.areasCount}+ towns across the Costa Blanca. Don't see yours? Just ask on WhatsApp.`}
    </p>
  </Container>
</section>

<FinalCta locale={locale} />
