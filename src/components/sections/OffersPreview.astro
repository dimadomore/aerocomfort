---
import { type Locale } from '../../config';
import { offers } from '../../data';
import { useTranslations, localizedPath } from '../../i18n/utils';
import Container from '../ui/Container.astro';
import MoreLink from '../ui/MoreLink.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import OfferCard from '../ui/OfferCard.astro';
import Carousel from '../ui/Carousel.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const es = locale === 'es';
const offersHref = localizedPath('/offers', locale);
---
<section class="bg-surface-cool py-16 lg:py-24">
  <Container>
    <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-5">
      <SectionHeading
        title={es ? 'Equipos instalados a precio de temporada' : 'Units at season prices, installed'}
        intro={offers.season.label[locale]}
      />
      <MoreLink href={offersHref}>{t('cta.offers')}</MoreLink>
    </div>

    <Carousel locale={locale} label={es ? 'Ofertas de temporada' : 'Seasonal offers'} class="mt-10">
      {offers.items.map((o) => (
        <div class="w-[82%] sm:w-[20rem] lg:w-[21rem]">
          <OfferCard offer={o} locale={locale} />
        </div>
      ))}
    </Carousel>
  </Container>
</section>
