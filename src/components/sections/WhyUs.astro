---
import { type Locale } from '../../config';
import { ratingLabel, reviewCountDisplay } from '../../data';
import Container from '../ui/Container.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const es = locale === 'es';

// Real, owner-confirmed facts (John, 2026-06-14).
const items = [
  {
    t: es ? 'Un responsable, un equipo en tu casa' : 'One person in charge, a full team on site',
    d: es ? 'Gregorio trabaja a pie de obra junto a su equipo de especialistas, así siempre sabes quién responde.' : 'Gregorio works on site alongside a team of specialists, so you always know who is responsible.',
  },
  {
    t: es ? 'Respuesta en menos de una hora' : 'A reply within the hour',
    d: es ? 'En horario laboral, por teléfono o WhatsApp. Las instalaciones, normalmente en 24 a 72 horas.' : 'During working hours, by phone or WhatsApp. Installs usually follow within 24 to 72 hours.',
  },
  {
    t: `${ratingLabel(locale)} ${es ? 'en' : 'on'} Google`,
    d: es ? `${reviewCountDisplay} reseñas y más de 1000 instalaciones.` : `${reviewCountDisplay} reviews and 1000+ installations.`,
  },
  {
    t: es ? 'Certificados y con garantía' : 'Certified and guaranteed',
    d: es ? 'Cualificados para gases fluorados, con 3 años de garantía en el trabajo y 3 en el equipo.' : 'Qualified for refrigerant handling, with 3 years on our work and 3 on the unit.',
  },
  {
    t: es ? 'Precios claros' : 'Clear, upfront pricing',
    d: es ? 'Presupuesto gratis antes de empezar. Pago con tarjeta, transferencia, Bizum o efectivo.' : 'A free quote before we start. Pay by card, transfer, Bizum or cash.',
  },
];
---
<section class="bg-surface-cool py-16 lg:py-24">
  <Container class="grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-16">
    <div class="why__photo lg:col-span-5">
      <img src="/gallery/work-13.webp" alt={es ? 'Furgoneta de Aerocomfort en un trabajo' : 'Aerocomfort van on a job'} width="900" height="1200" loading="lazy" decoding="async" />
    </div>
    <div class="lg:col-span-7">
      <h2 class="text-h2">{es ? 'Un equipo local en el que confiar' : 'A local team you can rely on'}</h2>
      <dl class="mt-8 border-t border-brand-900/15">
        {items.map((it) => (
          <div class="grid gap-1 border-b border-brand-900/15 py-4 sm:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] sm:gap-6">
            <dt class="font-display font-bold text-brand-900">{it.t}</dt>
            <dd class="text-small text-ink-700">{it.d}</dd>
          </div>
        ))}
      </dl>
    </div>
  </Container>
</section>

<style>
  .why__photo {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-md);
  }
  .why__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (min-width: 1024px) {
    .why__photo {
      aspect-ratio: 4 / 5;
    }
  }
</style>
