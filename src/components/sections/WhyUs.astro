---
import { type Locale } from '../../config';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const es = locale === 'es';

// Real, owner-confirmed facts (John, 2026-06-14).
const items: { icon: 'star' | 'wind' | 'check' | 'shield-check'; t: string; d: string }[] = [
  {
    icon: 'star',
    t: es ? '5,0★ en Google' : '5.0★ on Google',
    d: es ? '160 reseñas y más de 1000 instalaciones.' : '160 reviews and 1000+ installations.',
  },
  {
    icon: 'shield-check',
    t: es ? 'Certificados y con garantía' : 'Certified & guaranteed',
    d: es ? 'Cualificados para gases fluorados; 3 años de garantía en trabajo y equipo.' : 'Qualified for refrigerant handling; 3-year guarantee on work and equipment.',
  },
  {
    icon: 'wind',
    t: es ? 'Local y rápido' : 'Local & fast',
    d: es ? 'Costa Blanca y Costa Cálida — instalación en 24–72 h según la temporada.' : 'Costa Blanca & Costa Cálida — installed in 24–72h depending on season.',
  },
  {
    icon: 'check',
    t: es ? 'Precios claros' : 'Clear, upfront pricing',
    d: es ? 'Presupuestos gratis — pago con tarjeta, transferencia, Bizum o efectivo.' : 'Free quotes — pay by card, transfer, Bizum or cash.',
  },
];
---
<section class="border-y border-line bg-surface-cool py-16 lg:py-24">
  <Container>
    <SectionHeading
      align="center"
      eyebrow={es ? 'Por qué Aerocomfort' : 'Why Aerocomfort'}
      title={es ? 'Aire fiable, bien hecho' : 'Reliable cooling, done right'}
      intro={es ? 'Un mismo profesional de principio a fin, con la valoración que lo respalda.' : 'One trusted specialist from start to finish, with the rating to back it up.'}
    />
    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {items.map((it) => (
        <div class="text-center">
          <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-xl bg-white text-brand-700 shadow-sm">
            <Icon name={it.icon} size={28} />
          </span>
          <h3 class="mt-5 text-h3">{it.t}</h3>
          <p class="mt-2 text-small text-ink-500">{it.d}</p>
        </div>
      ))}
    </div>
  </Container>
</section>
