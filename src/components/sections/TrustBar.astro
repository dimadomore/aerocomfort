---
import { type Locale } from '../../config';
import { business } from '../../data';
import Container from '../ui/Container.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const es = locale === 'es';

// Years / installations come from the owner (C1) — shown as ‹N› placeholders,
// styled muted until filled, so the bar still reads as intentional (docs/08 §2.2).
const stats = [
  { value: '‹N›+', label: es ? 'años de experiencia' : 'years experience', pending: true },
  { value: '‹N›+', label: es ? 'instalaciones' : 'installations', pending: true },
  { value: `${business.rating.value}★`, label: es ? `${business.rating.count} reseñas Google` : `${business.rating.count} Google reviews`, pending: false },
  { value: `${business.areasCount}+`, label: es ? 'zonas cubiertas' : 'areas covered', pending: false },
];
---
<section class="border-b border-line bg-surface-cool" aria-label={es ? 'En cifras' : 'By the numbers'}>
  <Container class="py-9 lg:py-11">
    <div class="grid grid-cols-2 gap-x-4 gap-y-8 lg:grid-cols-4">
      {stats.map((s) => (
        <div class="flex flex-col items-center text-center">
          <span class:list={['font-display text-h2 font-extrabold tabular-nums', s.pending ? 'text-ink-400' : 'text-brand-700']}>{s.value}</span>
          <span class="mt-1.5 text-small text-ink-500">{s.label}</span>
        </div>
      ))}
    </div>
  </Container>
</section>
