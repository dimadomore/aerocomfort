---
import { type Locale } from '../../config';
import { AREAS, type Area } from '../../data/areas';
import { SERVICES } from '../../data/services';
import { business } from '../../data';
import { useTranslations, localizedPath } from '../../i18n/utils';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import AreaFinder from '../ui/AreaFinder.astro';
import ServiceRow from '../ui/ServiceRow.astro';
import Prose from '../ui/Prose.astro';
import PageHero from './PageHero.astro';
import FinalCta from './FinalCta.astro';

interface Props {
  locale: Locale;
  area: Area;
}
const { locale, area } = Astro.props;
const t = useTranslations(locale);
const es = locale === 'es';
const c = area[locale];

const waHref = `https://wa.me/${business.whatsapp.replace(/\D/g, '')}?text=${encodeURIComponent(business.whatsappMessage[locale])}`;
const contactHref = localizedPath('/contact', locale);
// Header photos are real jobs from the region, rotated so towns don't all match.
const HEADER_PHOTOS = ['28', '29', '34', '21', '09', '25'];
const photo = HEADER_PHOTOS[AREAS.findIndex((a) => a.slug === area.slug) % HEADER_PHOTOS.length];
const h1 = es ? `Aire acondicionado en ${c.name}` : `Air conditioning in ${c.name}`;
const crumbs = [
  { label: t('breadcrumb.home'), href: localizedPath('/', locale) },
  { label: t('nav.areas'), href: localizedPath('/areas', locale) },
  { label: c.name },
];
---
<PageHero crumbs={crumbs} title={h1} intro={c.intro} image={`/gallery/work-${photo}.webp`}>
  <div slot="cta" class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
    <Button href={contactHref} variant="primary" size="lg">
      {t('cta.quote')}
      <Icon name="arrow-right" size={20} />
    </Button>
    <Button href={waHref} variant="whatsapp" size="lg" target="_blank" rel="noopener">
      <Icon name="whatsapp" size={20} />
      {t('cta.whatsapp')}
    </Button>
  </div>
</PageHero>

<section class="py-16 lg:py-24">
  <Container class="grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-6">
      <h2 class="mb-5 text-h2">{es ? `Tu aire acondicionado en ${c.name}` : `Your air conditioning in ${c.name}`}</h2>
      <Prose>
        {c.body.map((p) => <p>{p}</p>)}
      </Prose>
    </div>
    <div class="lg:col-span-6">
      <h2 class="text-h3">{es ? `Servicios en ${c.name}` : `Services in ${c.name}`}</h2>
      <div class="mt-4 border-t border-line">
        {SERVICES.map((s) => <ServiceRow service={s} locale={locale} />)}
      </div>
    </div>
  </Container>
</section>

<section class="bg-surface-cool py-16 lg:py-20">
  <Container>
    <h2 class="mb-6 text-h3">{es ? 'Otras zonas' : 'Other areas'}</h2>
    <AreaFinder locale={locale} limit={8} exclude={area.slug} />
  </Container>
</section>

<FinalCta locale={locale} />
