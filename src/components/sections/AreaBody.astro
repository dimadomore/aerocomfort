---
import { type Locale } from '../../config';
import { type Area } from '../../data/areas';
import { AREAS } from '../../data/areas';
import { SERVICES } from '../../data/services';
import { business } from '../../data';
import { useTranslations, localizedPath } from '../../i18n/utils';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import Prose from '../ui/Prose.astro';
import PageHero from './PageHero.astro';
import FinalCta from './FinalCta.astro';

interface Props {
  locale: Locale;
  area: Area;
}
const { locale, area } = Astro.props;
const t = useTranslations(locale);
const es = locale === 'es';
const c = area[locale];

const waHref = `https://wa.me/${business.whatsapp.replace(/\D/g, '')}?text=${encodeURIComponent(business.whatsappMessage[locale])}`;
const contactHref = localizedPath('/contact', locale);
const others = AREAS.filter((a) => a.slug !== area.slug);
const h1 = es ? `Aire acondicionado en ${c.name}` : `Air conditioning in ${c.name}`;
const crumbs = [
  { label: t('breadcrumb.home'), href: localizedPath('/', locale) },
  { label: t('nav.areas'), href: localizedPath('/areas', locale) },
  { label: c.name },
];
---
<PageHero crumbs={crumbs} eyebrow={es ? 'Zona de servicio' : 'Service area'} title={h1} intro={c.intro}>
  <div slot="cta" class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
    <Button href={contactHref} variant="primary" size="lg">
      {t('cta.quote')}
      <Icon name="arrow-right" size={20} />
    </Button>
    <Button href={waHref} variant="whatsapp" size="lg" target="_blank" rel="noopener">
      <Icon name="whatsapp" size={20} />
      {t('cta.whatsapp')}
    </Button>
  </div>
</PageHero>

<section class="py-16 lg:py-24">
  <Container>
    <div class="grid gap-12 lg:grid-cols-3 lg:gap-16">
      <div class="lg:col-span-2">
        <Prose>
          {c.body.map((p) => <p>{p}</p>)}
        </Prose>
      </div>
      <aside class="lg:col-span-1">
        <div class="rounded-xl bg-surface-cool p-6 ring-1 ring-line">
          <h2 class="text-h3">{es ? `Servicios en ${c.name}` : `Services in ${c.name}`}</h2>
          <ul class="mt-4 space-y-2.5">
            {SERVICES.map((s) => (
              <li>
                <a class="inline-flex items-center gap-2.5 text-body font-semibold text-ink-700 transition-colors hover:text-brand-700" href={localizedPath(`/services/${s.slug}`, locale)}>
                  <Icon name={s.icon} size={20} class="text-brand-700" />
                  {s[locale].title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </Container>
</section>

<section class="border-t border-line bg-surface-cool py-14">
  <Container>
    <h2 class="text-h3">{es ? 'Otras zonas' : 'Other areas'}</h2>
    <div class="mt-5 flex flex-wrap gap-2.5">
      {others.map((a) => (
        <a
          class="inline-flex items-center gap-1.5 rounded-pill border border-line bg-white px-4 py-2 text-small font-semibold text-ink-700 transition-colors hover:border-blue-300 hover:text-brand-700"
          href={localizedPath(`/areas/${a.slug}`, locale)}
        >
          <Icon name="map-pin" size={15} class="text-brand-600" />
          {a[locale].name}
        </a>
      ))}
    </div>
  </Container>
</section>

<FinalCta locale={locale} />
