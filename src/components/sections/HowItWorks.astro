---
import { type Locale } from '../../config';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const es = locale === 'es';

const steps = [
  {
    n: '01',
    t: es ? 'Cuéntanos qué necesitas' : 'Tell us what you need',
    d: es ? 'Por formulario, WhatsApp o llamada — lo que te resulte más fácil.' : 'By form, WhatsApp or call — whatever is easiest for you.',
  },
  {
    n: '02',
    t: es ? 'Visitamos y presupuestamos' : 'We visit and quote',
    d: es ? 'Valoramos tu espacio y te damos un presupuesto claro y gratis.' : 'We assess your space and give you a clear, free quote.',
  },
  {
    n: '03',
    t: es ? 'Hacemos el trabajo' : 'We do the job',
    d: es ? 'Trabajo limpio y profesional — con garantía.' : 'Clean, professional work — guaranteed.',
  },
];
---
<section class="py-16 lg:py-24">
  <Container>
    <SectionHeading
      eyebrow={es ? 'Cómo trabajamos' : 'How it works'}
      title={es ? 'Tres pasos sencillos' : 'Three simple steps'}
    />
    <ol class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
      {steps.map((s, i) => (
        <li class="relative">
          <div class="flex items-center gap-4">
            <span class="font-display text-display font-extrabold leading-none text-brand-600">{s.n}</span>
            {i < steps.length - 1 && (
              <span class="hidden h-0.5 flex-1 rounded-full bg-linear-to-r from-blue-300 to-transparent md:block" aria-hidden="true"></span>
            )}
          </div>
          <h3 class="mt-4 text-h3">{s.t}</h3>
          <p class="mt-2 text-body text-ink-500">{s.d}</p>
        </li>
      ))}
    </ol>
  </Container>
</section>
