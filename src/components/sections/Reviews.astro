---
import { type Locale, ELFSIGHT_ID } from '../../config';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const es = locale === 'es';
---
<section class="border-y border-line bg-surface-cool py-16 lg:py-24">
  <Container class="text-center">
    <div class="flex items-center justify-center gap-1.5 text-warning">
      {Array.from({ length: 5 }).map(() => <Icon name="star" size={26} />)}
    </div>
    <h2 class="mt-5 text-h1">{es ? 'Valorados 5,0 en Google' : 'Rated 5.0 on Google'}</h2>

    {
      ELFSIGHT_ID && (
        <div class="mx-auto mt-8 max-w-4xl" data-elfsight-id={ELFSIGHT_ID} style="min-height:320px" />
      )
    }
  </Container>
</section>

<script>
  // Lazy-mount the Elfsight Google-reviews widget on viewport (keeps Lighthouse green).
  // The widget renders its own rating, count and "Review on Google" button.
  const host = document.querySelector<HTMLElement>('[data-elfsight-id]');
  if (host) {
    const id = host.getAttribute('data-elfsight-id');
    const io = new IntersectionObserver((entries, obs) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        if (!document.querySelector('script[data-elfsight-platform]')) {
          const s = document.createElement('script');
          s.src = 'https://static.elfsight.com/platform/platform.js';
          s.async = true;
          s.setAttribute('data-elfsight-platform', '');
          document.body.appendChild(s);
        }
        const w = document.createElement('div');
        if (id) w.className = id;
        w.setAttribute('data-elfsight-app-lazy', '');
        host.appendChild(w);
        obs.disconnect();
      });
    }, { rootMargin: '200px' });
    io.observe(host);
  }
</script>
