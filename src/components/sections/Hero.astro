---
import { type Locale } from '../../config';
import { useTranslations, localizedPath } from '../../i18n/utils';
import { business, reviewCountDisplay } from '../../data';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import CoolAir from '../ui/CoolAir.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const telHref = `tel:+${business.phoneE164.replace(/\D/g, '')}`;
const waHref = `https://wa.me/${business.whatsapp.replace(/\D/g, '')}?text=${encodeURIComponent(business.whatsappMessage[locale])}`;
const contactHref = localizedPath('/contact', locale);
const regionUpper = 'Costa Blanca · Costa Cálida';
---
<section class="hero-band relative overflow-hidden text-white">
  <!-- Signature motif: animated cool-air currents + frost (docs/04 §7) -->
  <CoolAir variant="hero" />

  <Container class="relative z-10 py-14 lg:py-24">
    <div class="max-w-3xl">
      <p class="inline-flex items-center gap-2 text-small font-semibold text-sky-200">
        <Icon name="map-pin" size={16} class="text-cyan-400" />
        {regionUpper}
      </p>

      <h1 class="mt-5 text-display text-white">
        {t('hero.h1.lead')} <span class="place">{t('hero.h1.place')}</span>
        <span class="mt-3 block font-display text-h2 font-semibold text-white/85">
          — {t('hero.h1.tail')}
        </span>
      </h1>

      <p class="mt-6 max-w-xl text-body-lg text-white/85">{t('hero.sub')}</p>

      <div class="mt-7 inline-flex items-center gap-2.5 rounded-pill bg-white/12 px-4 py-2 ring-1 ring-white/20">
        <Icon name="star" size={18} class="text-warning" />
        <span class="text-small font-semibold">{business.rating.value} {locale === 'es' ? 'en' : 'on'} Google · {reviewCountDisplay} {locale === 'es' ? 'reseñas' : 'reviews'}</span>
      </div>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
        <Button href={contactHref} variant="primary" size="lg" class="cta-attention">
          {t('cta.quote')}
          <Icon name="arrow-right" size={20} />
        </Button>
        <Button href={waHref} variant="whatsapp" size="lg" target="_blank" rel="noopener">
          <Icon name="whatsapp" size={20} />
          {t('cta.whatsapp')}
        </Button>
        <Button href={telHref} variant="secondary" size="lg">
          <Icon name="phone" size={18} />
          {business.phone}
        </Button>
      </div>
    </div>

  </Container>
</section>

<style>
  /* Temperature gradient: deep "warm-side" blue upper-left cooling toward the
     fresher brand blue lower-right — the band itself reads as air cooling down. */
  .hero-band {
    background: linear-gradient(150deg, var(--brand-800) 0%, var(--brand-700) 58%, #2170cd 100%);
  }

  /* Accent underline on the place word — energy without hurting text contrast */
  .place {
    position: relative;
    white-space: nowrap;
  }
  .place::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.04em;
    height: 0.16em;
    border-radius: var(--radius-pill);
    background: var(--accent-500);
  }
</style>
