---
import { type Locale } from '../../config';
import { useTranslations, getNav, localizedPath } from '../../i18n/utils';
import { business } from '../../data';
import Container from '../ui/Container.astro';
import Logo from '../ui/Logo.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  locale: Locale;
  path: string;
}
const { locale, path } = Astro.props;
const t = useTranslations(locale);
const nav = getNav(locale);
const offersItem = nav.find((n) => n.highlight);

/** Active when the current page IS the nav target or sits under it (e.g.
 *  /services/installation highlights "Services"). `path` is the EN route key. */
const isActive = (en: string) => path === en || (en !== '/' && path.startsWith(en + '/'));

const homeHref = localizedPath('/', locale);
const enHref = localizedPath(path, 'en');
const esHref = localizedPath(path, 'es');

const telHref = `tel:+${business.phoneE164.replace(/\D/g, '')}`;
const waDigits = business.whatsapp.replace(/\D/g, '');
const waHref = `https://wa.me/${waDigits}?text=${encodeURIComponent(business.whatsappMessage[locale])}`;
const contactHref = localizedPath('/contact', locale);
---
<header class="sticky top-0 z-40 border-b border-line bg-surface/90 backdrop-blur-md">
  <Container>
    <div class="flex h-16 items-center justify-between gap-4 lg:h-20">
      <a href={homeHref} class="flex items-center gap-2.5 rounded-md" aria-label="Aerocomfort — home">
        <Logo height={38} color="brand" />
      </a>

      <nav class="hidden items-center gap-7 lg:flex" aria-label="Primary">
        {
          nav.map((item) =>
            item.highlight ? (
              <a href={item.href} class="offers-nav" aria-current={isActive(item.en) ? 'page' : undefined}>
                <span class="salut" aria-hidden="true" />
                <span class="offers-nav__badge">{item.label}</span>
              </a>
            ) : (
              <a
                href={item.href}
                class:list={['nav-link', isActive(item.en) && 'nav-link--active']}
                aria-current={isActive(item.en) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ),
          )
        }
      </nav>

      <div class="flex items-center gap-2 lg:gap-3">
        <!-- Desktop cluster (one display utility per wrapper → no hidden/flex clash) -->
        <div class="hidden items-center gap-3 lg:flex">
          <div class="flex items-center gap-1.5 text-small font-bold" aria-label="Language">
            <a href={enHref} hreflang="en" class:list={[locale === 'en' ? 'text-brand-700' : 'text-ink-400 hover:text-ink-700']}>EN</a>
            <span class="text-line">/</span>
            <a href={esHref} hreflang="es" class:list={[locale === 'es' ? 'text-brand-700' : 'text-ink-400 hover:text-ink-700']}>ES</a>
          </div>
          <Button href={telHref} variant="ghost" size="md">
            <Icon name="phone" size={18} />
            {business.phone}
          </Button>
          <Button href={contactHref} variant="primary" size="md" class="cta-attention">
            {t('cta.quote')}
          </Button>
        </div>

        <!-- Mobile cluster: Offers + one-tap contact straight from the header (docs/05 §2) -->
        <div class="flex items-center gap-1.5 lg:hidden">
          {offersItem && (
            <a href={offersItem.href} class="offers-nav mr-1" aria-label={offersItem.label}>
              <span class="salut" aria-hidden="true" />
              <span class="offers-nav__badge">{offersItem.label}</span>
            </a>
          )}
          <a
            href={waHref}
            class="flex min-h-11 min-w-11 items-center justify-center rounded-full text-wa-600"
            aria-label={t('cta.whatsapp')}
            target="_blank"
            rel="noopener"
          >
            <Icon name="whatsapp" size={26} />
          </a>
          <a
            href={telHref}
            class="flex min-h-11 min-w-11 items-center justify-center rounded-full text-brand-700"
            aria-label={t('cta.call')}
          >
            <Icon name="phone" size={24} />
          </a>
          <button
            id="nav-toggle"
            type="button"
            class="flex min-h-11 min-w-11 items-center justify-center rounded-md text-ink-900"
            aria-label={t('nav.menu')}
            aria-expanded="false"
            aria-controls="mobile-nav"
          >
            <Icon name="menu" size={26} />
          </button>
        </div>
      </div>
    </div>
  </Container>

  <div id="mobile-nav" class="border-t border-line bg-surface lg:hidden" hidden>
    <Container>
      <nav class="flex flex-col py-3" aria-label="Mobile">
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.en) ? 'page' : undefined}
              class:list={[
                'border-b border-line py-3.5 text-body font-semibold',
                isActive(item.en)
                  ? 'border-l-[3px] border-l-accent-600 pl-3 text-brand-700'
                  : 'text-ink-900',
              ]}
            >
              {item.label}
            </a>
          ))
        }
        <div class="flex flex-col gap-3 pt-5 pb-3">
          <Button href={contactHref} variant="primary" size="lg" class="cta-attention">{t('cta.quote')}</Button>
          <Button href={waHref} variant="whatsapp" size="lg" target="_blank" rel="noopener">
            <Icon name="whatsapp" size={20} />
            {t('cta.whatsapp')}
          </Button>
        </div>
        <div class="flex items-center justify-center gap-2 pb-4 text-small font-bold">
          <a href={enHref} hreflang="en" class:list={[locale === 'en' ? 'text-brand-700' : 'text-ink-400']}>EN</a>
          <span class="text-line">/</span>
          <a href={esHref} hreflang="es" class:list={[locale === 'es' ? 'text-brand-700' : 'text-ink-400']}>ES</a>
        </div>
      </nav>
    </Container>
  </div>
</header>

<style>
  /* Open menu: a panel from under the header bar to the bottom, scrollable on its
     own if the content is tall. Kept in normal flow so the sticky header still
     works (we must NOT set overflow:hidden on <html>, which un-sticks it). */
  @media (max-width: 1023px) {
    #mobile-nav:not([hidden]) {
      max-height: calc(100dvh - 4rem);
      overflow-y: auto;
      overscroll-behavior: contain;
    }
  }
</style>

<script>
  const btn = document.getElementById('nav-toggle');
  const panel = document.getElementById('mobile-nav');

  // Block background scrolling WITHOUT touching overflow (which would break the
  // sticky header). Allow scrolling inside the menu itself when it overflows.
  const blockScroll = (e: Event) => {
    if (panel && panel.scrollHeight > panel.clientHeight && panel.contains(e.target as Node)) return;
    e.preventDefault();
  };

  const setOpen = (open: boolean) => {
    btn?.setAttribute('aria-expanded', String(open));
    if (panel) panel.hidden = !open;
    const fn = open ? document.addEventListener : document.removeEventListener;
    fn.call(document, 'touchmove', blockScroll, { passive: false });
    fn.call(document, 'wheel', blockScroll, { passive: false });
  };

  btn?.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  // Close (and release the lock) on navigation or when returning to desktop width.
  panel?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1024) setOpen(false);
  });
</script>
