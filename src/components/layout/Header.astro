---
import { type Locale } from '../../config';
import { useTranslations, getNav, localizedPath } from '../../i18n/utils';
import { business } from '../../data';
import { PROMO } from '../../data/promo';
import Container from '../ui/Container.astro';
import Logo from '../ui/Logo.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  locale: Locale;
  path: string;
}
const { locale, path } = Astro.props;
const t = useTranslations(locale);
const nav = getNav(locale);
const offersItem = nav.find((n) => n.highlight);

/** Active when the current page IS the nav target or sits under it (e.g.
 *  /services/installation highlights "Services"). `path` is the EN route key. */
const isActive = (en: string) => path === en || (en !== '/' && path.startsWith(en + '/'));

const homeHref = localizedPath('/', locale);
const enHref = localizedPath(path, 'en');
const esHref = localizedPath(path, 'es');

const telHref = `tel:+${business.phoneE164.replace(/\D/g, '')}`;
const waDigits = business.whatsapp.replace(/\D/g, '');
const waHref = `https://wa.me/${waDigits}?text=${encodeURIComponent(business.whatsappMessage[locale])}`;
const contactHref = localizedPath('/contact', locale);
// The running promotion gets a badge next to the logo on phones (src/data/promo.ts).
const promoHref = PROMO.active && path !== PROMO.path ? localizedPath(PROMO.path, locale) : '';
---
<header class="sticky top-0 z-40 border-b border-line bg-surface">
  <Container>
    <div class="flex h-16 items-center justify-between gap-2 lg:h-20 lg:gap-4">
      <a href={homeHref} class="flex items-center gap-2.5 rounded-md" aria-label="Aerocomfort, home">
        <Logo height={38} color="brand-900" />
      </a>

      {promoHref && (
        <a href={promoHref} class="promo-badge" data-cta="promo-badge" aria-label={`${PROMO.label}: €${PROMO.price}`}>
          <span>Black</span>
          <span>Friday</span>
        </a>
      )}

      <nav class="hidden items-center gap-6 lg:flex xl:gap-7" aria-label="Primary">
        {
          nav.map((item) =>
            item.highlight ? (
              <a href={item.href} class="offers-chip" aria-current={isActive(item.en) ? 'page' : undefined}>
                <Icon name="tag" size={16} />
                {item.label}
              </a>
            ) : (
              <a
                href={item.href}
                class:list={['nav-link', isActive(item.en) && 'nav-link--active']}
                aria-current={isActive(item.en) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ),
          )
        }
      </nav>

      <div class="flex items-center gap-2 lg:gap-3">
        <!-- Desktop cluster (one display utility per wrapper → no hidden/flex clash) -->
        <div class="hidden items-center gap-4 lg:flex">
          <div class="lang" aria-label="Language">
            <a href={enHref} hreflang="en" aria-current={locale === 'en' ? 'true' : undefined}>EN</a>
            <a href={esHref} hreflang="es" aria-current={locale === 'es' ? 'true' : undefined}>ES</a>
          </div>
          <a href={telHref} class="nav-link hidden gap-2 whitespace-nowrap xl:inline-flex">
            <Icon name="phone" size={18} />
            {business.phone}
          </a>
          <Button href={contactHref} variant="primary" size="md" class="whitespace-nowrap">
            {t('cta.quote')}
          </Button>
        </div>

        <!-- Mobile cluster: Offers + one-tap contact straight from the header (docs/05 §2) -->
        <div class="flex items-center gap-1 lg:hidden">
          {offersItem && (
            <a href={offersItem.href} class:list={['offers-chip', promoHref ? 'offers-chip--compact' : 'mr-1']} aria-current={isActive(offersItem.en) ? 'page' : undefined}>
              <Icon name="tag" size={15} />
              {offersItem.label}
            </a>
          )}
          <a
            href={waHref}
            class="flex min-h-11 min-w-11 items-center justify-center rounded-md text-wa-600"
            aria-label={t('cta.whatsapp')}
            target="_blank"
            rel="noopener"
          >
            <Icon name="whatsapp" size={26} />
          </a>
          <a
            href={telHref}
            class="flex min-h-11 min-w-11 items-center justify-center rounded-md text-brand-900"
            aria-label={t('cta.call')}
          >
            <Icon name="phone" size={24} />
          </a>
          <button
            id="nav-toggle"
            type="button"
            class="flex min-h-11 min-w-11 items-center justify-center rounded-md text-brand-900"
            aria-label={t('nav.menu')}
            aria-expanded="false"
            aria-controls="mobile-nav"
            data-open-label={t('nav.menu')}
            data-close-label={t('nav.close')}
          >
            <span class="toggle-open"><Icon name="menu" size={26} /></span>
            <span class="toggle-close"><Icon name="close" size={26} /></span>
          </button>
        </div>
      </div>
    </div>
  </Container>

  <div id="mobile-nav" class="bg-brand-900 text-white lg:hidden" data-cta="mobile-menu" hidden>
    <Container class="flex min-h-full flex-col">
      <nav class="flex flex-col pt-3" aria-label="Mobile">
        {
          nav.map((item) => (
            <a href={item.href} class="menu-link" aria-current={isActive(item.en) ? 'page' : undefined}>
              {item.label}
              <Icon name={item.highlight ? 'tag' : 'arrow-right'} size={22} />
            </a>
          ))
        }
      </nav>
      <div class="mt-auto flex flex-col gap-3 pt-8 pb-6">
        <Button href={waHref} variant="whatsapp" size="lg" target="_blank" rel="noopener">
          <Icon name="whatsapp" size={20} />
          {t('cta.whatsapp')}
        </Button>
        <Button href={contactHref} variant="primary" size="lg">{t('cta.quote')}</Button>
        <div class="lang lang--dark mx-auto mt-2" aria-label="Language">
          <a href={enHref} hreflang="en" aria-current={locale === 'en' ? 'true' : undefined}>EN</a>
          <a href={esHref} hreflang="es" aria-current={locale === 'es' ? 'true' : undefined}>ES</a>
        </div>
      </div>
    </Container>
  </div>
</header>

<style>
  /* Promotion badge beside the logo on phones: a small black price tag, tilted a
     touch so it reads as a sticker. Pushes itself left so it sits by the logo. */
  .promo-badge {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 2px;
    margin-right: auto;
    padding: 0.4rem 0.5rem;
    border-radius: 4px;
    background: #0a0c10;
    font-family: var(--font-display);
    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    line-height: 1;
    color: #fff;
    text-transform: uppercase;
    text-decoration: none;
    transform: rotate(-4deg);
  }
  .promo-badge span:last-child {
    color: var(--warning);
  }
  /* Desktop shows the bar under the header instead (a scoped rule: `lg:hidden`
     would lose to the display set above). */
  @media (min-width: 1024px) {
    .promo-badge {
      display: none;
    }
  }
  /* With the badge in the row the Offers chip drops its icon; on very narrow
     phones it steps aside (Offers stays in the menu). */
  .offers-chip--compact {
    padding-inline: 0.55rem;
  }
  .offers-chip--compact :global(svg) {
    display: none;
  }
  @media (max-width: 369px) {
    .offers-chip--compact {
      display: none;
    }
  }

  /* Language switch: two segments, the current one filled. */
  .lang {
    display: inline-flex;
    padding: 2px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
  }
  .lang a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.25rem;
    min-height: 2rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-display);
    font-size: var(--text-caption);
    font-weight: 700;
    color: var(--brand-900);
    text-decoration: none;
    transition: background-color 0.15s ease-out, color 0.15s ease-out;
  }
  .lang a:hover {
    background: var(--surface-cool);
  }
  .lang a[aria-current] {
    background: var(--brand-900);
    color: #fff;
  }
  .lang--dark {
    border-color: rgb(255 255 255 / 0.3);
  }
  .lang--dark a {
    min-width: 3rem;
    min-height: 2.75rem;
    color: #fff;
  }
  .lang--dark a:hover {
    background: rgb(255 255 255 / 0.12);
  }
  .lang--dark a[aria-current] {
    background: #fff;
    color: var(--brand-900);
  }

  #nav-toggle span {
    display: inline-flex;
  }
  .toggle-close,
  #nav-toggle[aria-expanded='true'] .toggle-open {
    display: none !important;
  }
  #nav-toggle[aria-expanded='true'] .toggle-close {
    display: inline-flex !important;
  }

  .menu-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.75rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.15);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: #fff;
    text-decoration: none;
    transition: color 0.15s ease-out;
  }
  .menu-link :global(svg) {
    opacity: 0.7;
    transition: transform 0.2s ease-out;
  }
  .menu-link:hover :global(svg) {
    transform: translateX(4px);
  }
  .menu-link[aria-current='page'] {
    color: #4cc9f0;
  }
  #mobile-nav :focus-visible {
    outline-color: #fff;
  }

  /* Open menu: fills the screen under the header bar and scrolls on its own if
     tall. Kept in normal flow so the sticky header still works (we must NOT set
     overflow:hidden on <html>, which un-sticks it). */
  @media (max-width: 1023px) {
    #mobile-nav:not([hidden]) {
      height: calc(100dvh - 4rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      animation: menu-in 0.22s cubic-bezier(0.22, 1, 0.36, 1);
    }
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
</style>

<script>
  const btn = document.getElementById('nav-toggle') as HTMLButtonElement | null;
  const panel = document.getElementById('mobile-nav');

  // Block background scrolling WITHOUT touching overflow (which would break the
  // sticky header). Allow scrolling inside the menu itself when it overflows.
  const blockScroll = (e: Event) => {
    if (panel && panel.scrollHeight > panel.clientHeight && panel.contains(e.target as Node)) return;
    e.preventDefault();
  };

  const setOpen = (open: boolean) => {
    btn?.setAttribute('aria-expanded', String(open));
    btn?.setAttribute('aria-label', (open ? btn.dataset.closeLabel : btn.dataset.openLabel) ?? '');
    if (panel) panel.hidden = !open;
    // The menu has its own contact buttons, so the bottom bar steps aside while it is open.
    document.documentElement.classList.toggle('menu-open', open);
    const fn = open ? document.addEventListener : document.removeEventListener;
    fn.call(document, 'touchmove', blockScroll, { passive: false });
    fn.call(document, 'wheel', blockScroll, { passive: false });
  };

  btn?.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  // Close (and release the lock) on navigation or when returning to desktop width.
  panel?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1024) setOpen(false);
  });
</script>
