---
import { type Locale } from '../../config';
import { useTranslations, getNav, localizedPath } from '../../i18n/utils';
import { business, isPlaceholder, reviewCountDisplay } from '../../data';
import Container from '../ui/Container.astro';
import Logo from '../ui/Logo.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const nav = getNav(locale);
const year = new Date().getFullYear();

const telHref = `tel:+${business.phoneE164.replace(/\D/g, '')}`;
const waHref = `https://wa.me/${business.whatsapp.replace(/\D/g, '')}`;
const mailHref = `mailto:${business.email}`;

const legalLinks = [
  { label: locale === 'es' ? 'Privacidad' : 'Privacy', en: '/privacy' },
  { label: 'Cookies', en: '/cookies' },
  { label: locale === 'es' ? 'Aviso legal' : 'Legal notice', en: '/legal' },
];

const hasReg = !isPlaceholder(business.legalName) && !isPlaceholder(business.taxId);
const areaWord = locale === 'es' ? 'zonas' : 'areas';
const linkCls = 'inline-flex items-center gap-3 text-small text-white/80 transition-colors hover:text-white';
---
<footer class="bg-brand-900 text-white">
  <Container class="py-14 lg:py-16">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <Logo height={40} color="white" />
        <p class="mt-4 max-w-xs text-small text-white/70">{t('footer.builtBy')}</p>
        <div class="mt-5 inline-flex items-center gap-2 rounded-pill bg-white/10 px-3.5 py-2">
          <Icon name="star" size={16} class="text-warning" />
          <span class="text-small font-bold">{business.rating.value}</span>
          <span class="text-small text-white/70">· {reviewCountDisplay} Google reviews</span>
        </div>
      </div>

      <nav class="lg:col-span-3" aria-label={locale === 'es' ? 'Servicios (pie)' : 'Footer services'}>
        <h2 class="text-caption font-bold tracking-wider text-white/70 uppercase">{t('nav.services')}</h2>
        <ul class="mt-4 space-y-2.5">
          {nav.map((i) => (
            <li><a class="text-small text-white/80 transition-colors hover:text-white" href={i.href}>{i.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="lg:col-span-5">
        <h2 class="text-caption font-bold tracking-wider text-white/70 uppercase">{t('nav.contact')}</h2>
        <ul class="mt-4 space-y-3.5">
          <li><a class={linkCls} href={telHref}><Icon name="phone" size={18} class="text-white/55" />{business.phone}</a></li>
          <li><a class={linkCls} href={waHref} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} class="text-white/55" />WhatsApp</a></li>
          <li><a class={linkCls} href={mailHref}><Icon name="mail" size={18} class="text-white/55" />{business.email}</a></li>
          <li><span class="inline-flex items-center gap-3 text-small text-white/70"><Icon name="map-pin" size={18} class="text-white/55" />{t('site.region')} · {business.areasCount}+ {areaWord}</span></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-white/10 pt-6 text-caption text-white/70 md:flex-row md:items-center md:justify-between">
      <p>© {year} {business.name}. {t('footer.rights')}</p>
      <div class="flex flex-wrap gap-x-5 gap-y-1">
        {legalLinks.map((l) => (
          <a class="text-white/70 transition-colors hover:text-white" href={localizedPath(l.en, locale)}>{l.label}</a>
        ))}
      </div>
    </div>
    <p class="mt-3 text-caption text-white/65">
      {hasReg ? `${business.legalName} · NIF ${business.taxId}` : t('footer.legalNote')}
    </p>
  </Container>
</footer>
