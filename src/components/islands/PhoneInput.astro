---
import { type Locale } from '../../config';
import { useTranslations } from '../../i18n/utils';
import { getCountryCallingCode, type CountryCode } from 'libphonenumber-js';

/**
 * Phone field with real per-country validation (libphonenumber-js) → solves the
 * brief's #1 pain: malformed lead numbers. Country select + masked input, live
 * validity, normalization to E.164 in a hidden field, "has WhatsApp" handled by
 * the form. Progressive enhancement: without JS it's a plain tel input.
 */
interface Props {
  locale: Locale;
  id?: string;
}
const { locale, id = 'phone' } = Astro.props;
const t = useTranslations(locale);

// Most common first (docs/00 §3): UK, Spain, Ireland, nearby northern Europe, the
// Nordics, the USA and Canada. Then a short list of other European countries with
// residents on the Costa Blanca, nearest to Spain first. Kept short on purpose
// (owner, Nov 2026): a number from any other country can still be typed with +code.
const common = ['GB', 'ES', 'IE', 'DE', 'NL', 'BE', 'FR', 'NO', 'SE', 'DK', 'FI', 'IS', 'US', 'CA'];
const others = ['PT', 'IT', 'CH', 'LU', 'AT', 'CZ', 'PL', 'RO', 'LT', 'UA'] as const;

const regionNames = new Intl.DisplayNames([locale], { type: 'region' });
const flag = (iso: string) => String.fromCodePoint(...[...iso].map((c) => 0x1f1a5 + c.charCodeAt(0)));
const country = (iso: string) => ({
  iso,
  name: iso === 'XK' ? 'Kosovo' : (regionNames.of(iso) ?? iso),
  dial: getCountryCallingCode(iso as CountryCode),
  flag: flag(iso),
});
const groups = [
  { label: locale === 'es' ? 'Más habituales' : 'Most common', countries: common.map(country) },
  {
    label: locale === 'es' ? 'Más países' : 'More countries',
    countries: others.map(country),
  },
];
const defaultIso = locale === 'es' ? 'ES' : 'GB';
---
<div
  class="lead-phone"
  data-phone-input
  data-err-invalid={t('form.errPhoneInvalid')}
  data-err-incomplete={t('form.errPhoneIncomplete')}
>
  <label class="lead-label" for={id}>{t('form.phone')}</label>
  <div class="lead-phone__combo">
    <select class="lead-control lead-phone__country" data-country aria-label={t('form.country')}>
      {groups.map((g) => (
        <optgroup label={g.label}>
          {g.countries.map((c) => (
            <option value={c.iso} selected={c.iso === defaultIso} data-short={`${c.flag} +${c.dial}`} data-long={`${c.flag} ${c.name} +${c.dial}`}>
              {c.flag} {c.name} +{c.dial}
            </option>
          ))}
        </optgroup>
      ))}
    </select>
    <input
      class="lead-control"
      type="tel"
      id={id}
      name="phone"
      inputmode="tel"
      autocomplete="tel"
      placeholder="612 34 56 78"
      data-phone
      {...{ toolparamdescription: 'Mobile number for the reply, without the country code.' }}
      required
    />
  </div>
  <input type="hidden" name="phone_e164" data-e164 />
  <p class="lead-error" data-error hidden></p>
  <p class="lead-hint">{t('form.phoneHint')}</p>
</div>

<style>
  .lead-phone__combo {
    display: grid;
    grid-template-columns: 8.25rem minmax(0, 1fr);
    gap: 0.5rem;
  }
  .lead-phone__country {
    width: 100%;
    min-width: 0;
    padding-inline: 0.6rem;
  }
  .lead-hint {
    margin-top: 0.4rem;
    font-size: var(--text-caption);
    color: var(--ink-400);
  }
</style>

<script>
  import { AsYouType, parsePhoneNumberFromString, type CountryCode } from 'libphonenumber-js';

  document.querySelectorAll<HTMLElement>('[data-phone-input]').forEach((root) => {
    const sel = root.querySelector<HTMLSelectElement>('[data-country]');
    const input = root.querySelector<HTMLInputElement>('[data-phone]');
    const hidden = root.querySelector<HTMLInputElement>('[data-e164]');
    const err = root.querySelector<HTMLElement>('[data-error]');
    if (!sel || !input || !hidden) return;

    const country = () => sel.value as CountryCode;
    let last = '';

    const setError = (msg: string) => {
      if (!err) return;
      err.textContent = msg;
      err.hidden = !msg;
    };

    const validate = (showError: boolean): boolean => {
      const raw = input.value.trim();
      hidden.value = '';
      root.dataset.valid = 'false';
      if (!raw) {
        input.setAttribute('aria-invalid', 'false');
        setError('');
        return false;
      }
      const pn = parsePhoneNumberFromString(raw, country());
      if (pn && pn.isValid()) {
        hidden.value = pn.number;
        root.dataset.valid = 'true';
        input.setAttribute('aria-invalid', 'false');
        setError('');
        return true;
      }
      input.setAttribute('aria-invalid', 'true');
      if (showError) {
        const digits = raw.replace(/\D/g, '').length;
        setError(digits < 6 ? root.dataset.errIncomplete! : root.dataset.errInvalid!);
      }
      return false;
    };

    input.addEventListener('input', () => {
      const val = input.value;
      // Reformat only while typing forward, so deletions/edits aren't fought.
      if (val.length > last.length && /\d/.test(val)) {
        input.value = new AsYouType(country()).input(val);
      }
      last = input.value;
      validate(false);
    });
    input.addEventListener('blur', () => validate(true));
    // The list shows full country names; the closed field only has room for the
    // flag and code, so the chosen option gets its short label.
    const syncLabels = () => {
      [...sel.options].forEach((o) => {
        const label = o.selected ? o.dataset.short : o.dataset.long;
        if (label) o.textContent = label;
      });
    };
    syncLabels();
    sel.addEventListener('change', () => {
      syncLabels();
      validate(Boolean(input.value));
    });
  });
</script>
