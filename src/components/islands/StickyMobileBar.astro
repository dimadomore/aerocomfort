---
import { type Locale } from '../../config';
import { useTranslations, localizedPath } from '../../i18n/utils';
import { business } from '../../data';
import { PROMO } from '../../data/promo';
import Icon from '../ui/Icon.astro';

/**
 * Bottom action bar for phones and tablets (docs/04 §6). Hidden on arrival; it
 * slides in once the visitor starts scrolling, so the first screen stays clean.
 * Two icon buttons (call, WhatsApp) and the quote button. Hidden on lg+.
 *
 * The cookie dialog sits above it and the bar stays out of the way until a choice
 * is made. The spacer keeps the end of the footer clear of the bar.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const es = locale === 'es';

const telHref = `tel:+${business.phoneE164.replace(/\D/g, '')}`;
const contactHref = localizedPath('/contact', locale);
const here = Astro.url.pathname.replace(/\/$/, '');
// On the promotion page the bar is the only call to action, so its WhatsApp
// message names the offer.
const onPromo = PROMO.active && here === localizedPath(PROMO.path, locale).replace(/\/$/, '');
const waText = onPromo ? PROMO.whatsapp[locale] : business.whatsappMessage[locale];
const waHref = `https://wa.me/${business.whatsapp.replace(/\D/g, '')}?text=${encodeURIComponent(waText)}`;
// On the contact page the form is already there, so the bar offers the two channels by name.
const onContact = here === contactHref.replace(/\/$/, '');
---
<div class="stickybar-spacer" aria-hidden="true"></div>
<nav
  class:list={['stickybar', onContact && 'stickybar--two']}
  aria-label={es ? 'Contacto rápido' : 'Quick contact'}
  data-sticky-bar
  data-cta="sticky-bar"
  aria-hidden="true"
  inert
>
  <a class="stickybar__btn stickybar__btn--call" href={telHref} aria-label={onContact ? undefined : es ? `Llamar al ${business.phone}` : `Call ${business.phone}`}>
    <Icon name="phone" size={22} />
    {onContact && t('cta.callShort')}
  </a>
  <a class="stickybar__btn stickybar__btn--wa" href={waHref} target="_blank" rel="noopener" aria-label={onContact ? undefined : es ? 'Escribir por WhatsApp' : 'Chat on WhatsApp'}>
    <Icon name="whatsapp" size={24} />
    {onContact && 'WhatsApp'}
  </a>
  {!onContact && (
    <a class="stickybar__btn stickybar__btn--quote" href={contactHref}>
      {t('cta.quote')}
      <Icon name="arrow-right" size={18} />
    </a>
  )}
</nav>

<style>
  .stickybar {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 40;
    display: grid;
    grid-template-columns: 52px 52px minmax(0, 1fr);
    gap: 0.5rem;
    /* On tablets the buttons stay in a phone-wide group in the middle. */
    padding: 0.5rem max(0.75rem, calc(50% - 15rem)) calc(0.5rem + env(safe-area-inset-bottom));
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(8px);
    border-top: 1px solid var(--line);
    box-shadow: 0 -6px 24px rgba(20, 38, 74, 0.08);
    transform: translateY(110%);
    transition: transform 0.25s ease-out;
  }
  .stickybar.is-visible {
    transform: translateY(0);
  }
  /* The cookie dialog comes first: the bar waits underneath until a choice is made.
     It also steps aside while the mobile menu is open, and returns when it closes. */
  :global(html.cc-open) .stickybar,
  :global(html.menu-open) .stickybar {
    visibility: hidden;
  }
  .stickybar--two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  /* Same height as the bar, in the footer's navy, so nothing ends up underneath it. */
  .stickybar-spacer {
    height: calc(52px + 1rem + env(safe-area-inset-bottom));
    background: var(--brand-900);
  }
  /* Hide on desktop via a scoped rule — a utility like `lg:hidden` loses to this
     component's scoped display (higher specificity from scoping). */
  @media (min-width: 1024px) {
    .stickybar,
    .stickybar-spacer {
      display: none;
    }
  }
  .stickybar__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-width: 0;
    height: 52px;
    border-radius: 4px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-small);
    white-space: nowrap;
    text-decoration: none;
  }
  .stickybar__btn--call {
    color: var(--brand-900);
    border: 1.5px solid rgb(17 48 92 / 0.3);
    background: #fff;
  }
  .stickybar__btn--wa {
    color: #fff;
    background: var(--wa-600);
  }
  .stickybar__btn--quote {
    color: #fff;
    background: var(--accent-600);
  }
  /* Very narrow phones: the label alone, so it stays on one line. */
  @media (max-width: 359px) {
    .stickybar__btn--quote :global(svg) {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .stickybar {
      transition: none;
    }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-sticky-bar]');
  if (bar) {
    let shown = false;
    const update = () => {
      const past = window.scrollY > 240;
      if (past !== shown) {
        shown = past;
        bar.classList.toggle('is-visible', past);
        bar.setAttribute('aria-hidden', String(!past));
        bar.toggleAttribute('inert', !past); // keep links out of focus order while hidden
      }
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>
