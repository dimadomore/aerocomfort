---
interface Props {
  title: string;
  intro?: string;
  align?: 'left' | 'center';
  light?: boolean;
  class?: string;
}
const { title, intro, align = 'left', light = false, class: cls = '' } = Astro.props;
---
<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center', cls]}>
  <h2 class:list={['text-h2', light && 'text-white']}>{title}</h2>
  {intro && <p class:list={['mt-3 text-body', light ? 'text-white/85' : 'text-ink-700']}>{intro}</p>}
</div>
