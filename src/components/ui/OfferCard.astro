---
import { type Locale } from '../../config';
import { type OfferItem } from '../../data';
import { localizedPath } from '../../i18n/utils';

interface Props {
  offer: OfferItem;
  locale: Locale;
}
const { offer, locale } = Astro.props;
const es = locale === 'es';
const contactHref = localizedPath('/contact', locale);
const cta = es ? 'Solicitar este equipo' : 'Request this unit';
---
<article class="flex flex-col overflow-hidden rounded-xl border border-line bg-white shadow-sm transition-all hover:-translate-y-1 hover:shadow-md">
  <div class="relative flex aspect-[4/3] items-center justify-center bg-sky-100">
    {/* placeholder until catalogue photos arrive (docs/08 §2.6) */}
    <svg viewBox="0 0 120 90" class="w-1/2 text-blue-300" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true">
      <rect x="14" y="26" width="92" height="26" rx="8" />
      <path d="M24 44h22M70 44h12" />
      <path d="M40 60c2-2 2-4 2-6M60 64c2-2 2-4 2-6M80 60c2-2 2-4 2-6" />
    </svg>
    {offer.efficiency && (
      <span class="absolute left-3 top-3 rounded-pill bg-brand-700 px-2.5 py-1 text-caption font-bold text-white">{offer.efficiency}</span>
    )}
  </div>
  <div class="flex flex-1 flex-col p-5">
    <p class="text-small text-ink-400">{offer.brand}</p>
    <h3 class="text-h3">{offer.model}</h3>
    <div class="mt-2 flex items-baseline gap-2">
      {offer.priceOld && <span class="text-body text-ink-400 line-through">€{offer.priceOld}</span>}
      <span class="font-display text-h2 font-extrabold text-accent-600">€{offer.priceNew}</span>
    </div>
    {offer.coverage && <p class="mt-1 text-caption text-ink-400">{offer.coverage}</p>}
    <a
      href={contactHref}
      class="mt-5 inline-flex min-h-11 items-center justify-center gap-2 rounded-pill bg-brand-700 px-5 font-display font-bold text-white transition-all hover:-translate-y-0.5 hover:bg-brand-800"
    >
      {cta}
    </a>
  </div>
</article>
