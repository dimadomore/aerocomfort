---
import { type Locale } from '../../config';
import { business, type OfferItem } from '../../data';
import { localizedPath } from '../../i18n/utils';
import Icon from './Icon.astro';

/**
 * A unit shown like its own rating plate: a plain spec table, the EU energy-label
 * arrow, and the price. Reads as a product you can compare, not a promo tile.
 */
interface Props {
  offer: OfferItem;
  locale: Locale;
}
const { offer, locale } = Astro.props;
const es = locale === 'es';
// Pass the unit so the contact form can pre-fill the message (DIM-279).
const contactHref = `${localizedPath('/contact', locale)}?unit=${encodeURIComponent(`${offer.brand} ${offer.model}`)}`;
const warranty = business.trust?.equipmentWarrantyYears;
const saving = offer.priceOld ? offer.priceOld - offer.priceNew : 0;
---
<article class="card offer flex h-full flex-col overflow-hidden">
  {offer.image && (
    <div class="offer__photo">
      <img src={offer.image} alt={`${offer.brand} ${offer.model}`} loading="lazy" decoding="async" />
    </div>
  )}
  <div class="flex flex-1 flex-col p-5">
    <p class="text-small font-semibold text-ink-700">{offer.brand}</p>
    <h3 class="text-h3">{offer.model}</h3>

    <dl class="offer__specs">
      {offer.efficiency && (
        <div>
          <dt>{es ? 'Eficiencia' : 'Efficiency'}</dt>
          <dd><span class="energy">{offer.efficiency}</span></dd>
        </div>
      )}
      {offer.coverage && (
        <div>
          <dt>{es ? 'Superficie' : 'Room size'}</dt>
          <dd>{offer.coverage}</dd>
        </div>
      )}
      <div>
        <dt>{es ? 'Instalación' : 'Installation'}</dt>
        <dd>{es ? 'Llave en mano' : 'Turnkey'}</dd>
      </div>
      {offer.wifi && (
        <div>
          <dt>Wi-Fi</dt>
          <dd>{es ? 'Incluido' : 'Included'}</dd>
        </div>
      )}
      {warranty && (
        <div>
          <dt>{es ? 'Garantía del equipo' : 'Unit warranty'}</dt>
          <dd>{es ? `${warranty} años` : `${warranty} years`}</dd>
        </div>
      )}
    </dl>

    <div class="mt-auto pt-5">
      <p class="flex flex-wrap items-baseline gap-x-2.5">
        <span class="font-display text-h2 font-extrabold text-brand-900">€{offer.priceNew}</span>
        {offer.priceOld && <s class="text-small text-ink-500">€{offer.priceOld}</s>}
        {saving > 0 && <span class="text-small font-semibold text-accent-700">{es ? `Ahorras €${saving}` : `Save €${saving}`}</span>}
      </p>
      <a
        href={contactHref}
        class="mt-4 inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-[4px] bg-brand-900 px-5 font-display font-bold text-white no-underline transition-colors duration-200 ease-out hover:bg-brand-700"
      >
        {es ? 'Solicitar este equipo' : 'Request this unit'}
        <Icon name="arrow-right" size={16} />
      </a>
    </div>
  </div>
</article>

<style>
  .offer__photo {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background: #fff;
  }
  .offer__photo img {
    width: 100%;
    height: 100%;
    padding: 1rem;
    object-fit: contain;
    transition: transform 0.4s ease-out;
  }
  .offer:hover .offer__photo img {
    transform: scale(1.04);
  }
  .offer__specs {
    margin-top: 1rem;
    border-top: 1px solid var(--line);
    font-size: var(--text-caption);
  }
  .offer__specs div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.5rem;
    border-bottom: 1px solid var(--line);
  }
  .offer__specs dt {
    color: var(--ink-700);
  }
  .offer__specs dd {
    font-weight: 600;
    color: var(--brand-900);
  }
  /* The arrow from the EU energy label, in the label's own green. */
  .energy {
    display: inline-block;
    padding: 0.125rem 1.1rem 0.125rem 0.5rem;
    font-family: var(--font-display);
    font-weight: 800;
    color: #fff;
    background: #00803e;
    clip-path: polygon(0 0, calc(100% - 0.7rem) 0, 100% 50%, calc(100% - 0.7rem) 100%, 0 100%);
  }
</style>
