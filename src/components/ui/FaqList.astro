---
/** Accordion shared by every FAQ on the site. Native <details>: works without JS. */
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---
<div class="faq-list">
  {items.map((f) => (
    <details class="faq">
      <summary>
        <span>{f.q}</span>
        <span class="faq__mark" aria-hidden="true"></span>
      </summary>
      <p>{f.a}</p>
    </details>
  ))}
</div>

<style>
  .faq-list {
    border-top: 1px solid var(--line);
  }
  .faq {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.125rem 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-size: var(--text-body);
    font-weight: 700;
    line-height: 1.35;
    color: var(--brand-900);
    transition: color 0.15s ease-out;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    color: var(--brand-700);
  }
  .faq__mark {
    position: relative;
    flex: none;
    width: 1rem;
    height: 1rem;
  }
  .faq__mark::before,
  .faq__mark::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 2px;
    margin-top: -1px;
    background: currentColor;
    transition: transform 0.2s ease-out;
  }
  .faq__mark::after {
    transform: rotate(90deg);
  }
  .faq[open] .faq__mark::after {
    transform: rotate(0deg);
  }
  p {
    max-width: 65ch;
    padding-bottom: 1.25rem;
    color: var(--ink-700);
  }
</style>
