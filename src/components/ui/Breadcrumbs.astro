---
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: Crumb[];
  class?: string;
}
const { items, class: cls = '' } = Astro.props;
---
<nav aria-label="Breadcrumb" class:list={['text-caption', cls]}>
  <ol class="flex flex-wrap items-center gap-2 text-white/75">
    {
      items.map((c, i) => (
        <li class="flex items-center gap-2">
          {c.href && i < items.length - 1 ? (
            <a class="text-white/75 no-underline transition-colors hover:text-white" href={c.href}>{c.label}</a>
          ) : (
            <span aria-current="page" class="font-medium text-white">{c.label}</span>
          )}
          {i < items.length - 1 && <span class="text-white/40" aria-hidden="true">/</span>}
        </li>
      ))
    }
  </ol>
</nav>
