---
import { type Locale } from '../../config';
import { useTranslations } from '../../i18n/utils';

/**
 * Reusable horizontal carousel (DIM-277). Native horizontal scroll + swipe on
 * touch, mouse drag on desktop, plus large, clearly-visible prev/next arrows.
 * Slides are the direct children passed via the default slot — set each slide's
 * width with utility classes on the child (e.g. `w-[82%] sm:w-[20rem]`).
 */
interface Props {
  locale: Locale;
  /** Accessible label for the scrollable region. */
  label: string;
  class?: string;
}
const { locale, label, class: cls = '' } = Astro.props;
const t = useTranslations(locale);
---
<div class:list={['carousel', cls]} data-carousel>
  <button class="carousel__arrow carousel__arrow--prev" type="button" data-prev aria-label={t('carousel.prev')}>
    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
  </button>

  <div class="carousel__track" data-track role="group" aria-label={label} tabindex="0">
    <slot />
  </div>

  <button class="carousel__arrow carousel__arrow--next" type="button" data-next aria-label={t('carousel.next')}>
    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
  </button>
</div>

<style>
  .carousel {
    position: relative;
  }
  .carousel__track {
    display: flex;
    gap: 1.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    /* Generous breathing room so a card's hover zoom + soft shadow are never
       clipped by the scroll container (it can't be overflow-y: visible while
       scrolling on x). Inline padding + scroll-padding keep the first/last
       card's scaled edges clear too, without breaking snap alignment. */
    padding-block: 1.75rem;
    padding-inline: 0.85rem;
    scroll-padding-inline: 0.85rem;
  }
  .carousel__track::-webkit-scrollbar {
    display: none;
  }
  .carousel__track.is-grabbing {
    scroll-behavior: auto;
    scroll-snap-type: none;
    cursor: grabbing;
    user-select: none;
  }
  /* slides come through the slot (different astro scope) — target globally but
     contained to this component's track */
  .carousel__track > :global(*) {
    flex: 0 0 auto;
    scroll-snap-align: start;
  }

  .carousel__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-pill);
    background: #fff;
    color: var(--brand-700);
    border: 1.5px solid var(--line);
    box-shadow: var(--shadow-lg);
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      opacity 0.2s ease,
      transform 0.2s ease;
  }
  .carousel__arrow:hover {
    background: var(--brand-700);
    color: #fff;
  }
  .carousel__arrow:active {
    transform: translateY(-50%) scale(0.94);
  }
  .carousel__arrow--prev {
    left: 0.25rem;
  }
  .carousel__arrow--next {
    right: 0.25rem;
  }
  .carousel__arrow:disabled {
    opacity: 0;
    pointer-events: none;
  }
  @media (min-width: 1024px) {
    .carousel__arrow {
      width: 3.25rem;
      height: 3.25rem;
    }
    .carousel__arrow--prev {
      left: -1rem;
    }
    .carousel__arrow--next {
      right: -1rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .carousel__track {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]');
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    if (!track || !prev || !next) return;

    const pageSize = () => Math.max(track.clientWidth * 0.85, 240);

    const update = () => {
      const max = track.scrollWidth - track.clientWidth - 2;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max;
    };

    const go = (dir: number) =>
      track.scrollBy({ left: dir * pageSize(), behavior: reduce ? 'auto' : 'smooth' });

    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();

    // Mouse drag-to-scroll (touch already scrolls natively).
    let down = false;
    let startX = 0;
    let startLeft = 0;
    let moved = false;
    track.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse') return;
      down = true;
      moved = false;
      startX = e.clientX;
      startLeft = track.scrollLeft;
      track.classList.add('is-grabbing');
    });
    track.addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 4) moved = true;
      track.scrollLeft = startLeft - dx;
    });
    const release = () => {
      if (!down) return;
      down = false;
      track.classList.remove('is-grabbing');
      update();
    };
    track.addEventListener('pointerup', release);
    track.addEventListener('pointerleave', release);
    // swallow the click that ends a drag so slide links aren't triggered
    track.addEventListener(
      'click',
      (e) => {
        if (moved) {
          e.preventDefault();
          e.stopPropagation();
        }
      },
      true,
    );
  });
</script>
