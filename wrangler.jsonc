{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "aerocomfort",
	"compatibility_date": "2026-06-12",
	// Worker handles the lead form POST (/api/lead); all other requests fall
	// through to the static Astro build served via the ASSETS binding.
	"main": "worker/index.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// Unknown addresses get the site's own 404 page (dist/404.html) with a 404
		// status, instead of an empty response.
		"not_found_handling": "404-page",
		// With not_found_handling set, browser navigations (opening /leads, a no-JS
		// form POST to /api/lead) are answered by the assets layer and never reach
		// the Worker: 404 / 405. These routes must go to the Worker first.
		"run_worker_first": ["/api/*", "/mcp", "/leads", "/leads/*", "/leads.csv"]
	},
	// Production domain: aero.dimadomore.com (temporary, until switching to aerocomfort.es).
	// The custom domain is attached at the account level via the Workers Domains API,
	// not declared here — the CI token has no zone-level Workers Routes permission.
	"workers_dev": false,
	// LEAD_EMAIL_FROM and LEAD_EMAIL_TO are plain variables set in the Cloudflare
	// dashboard. Without this, every `wrangler deploy` deletes them and lead
	// emails stop without any error.
	"keep_vars": true,
	// Preview URLs for `wrangler versions upload` (dev branch deploys)
	"preview_urls": true,
	// Lead storage (mini-CRM). The Worker writes each lead here and /leads reads
	// it. Local `wrangler dev` uses a local SQLite copy; apply the schema with:
	//   wrangler d1 migrations apply aerocomfort-leads --local   (and --remote for prod)
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "aerocomfort-leads",
			"database_id": "0f7286b3-9422-4d6b-99d2-56381adb9545",
			"migrations_dir": "migrations"
		}
	],
 "vars": {
    "LEAD_EMAIL_FROM": "onboarding@resend.dev",
    "LEAD_EMAIL_TO": "dimadomore@gmail.com"
  },
}
