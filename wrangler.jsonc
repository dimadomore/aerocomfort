{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "aerocomfort",
	"compatibility_date": "2026-06-12",
	// Worker handles the lead form POST (/api/lead); all other requests fall
	// through to the static Astro build served via the ASSETS binding.
	"main": "worker/index.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// Unknown addresses get the site's own 404 page (dist/404.html) with a 404
		// status, instead of an empty response.
		"not_found_handling": "404-page",
		// Pages live at addresses without a trailing slash (/about, /es), the same
		// form as the canonical URLs, the sitemap and the old Tilda site. /about/
		// redirects to /about (the Worker turns that redirect into a permanent 301).
		"html_handling": "drop-trailing-slash",
		// The Worker sees every request except the hashed build files and big media,
		// so it can answer /api/lead, /mcp and /leads, redirect www, http, old Tilda
		// addresses and (after launch) staging, and make redirects permanent.
		"run_worker_first": ["/*", "!/_astro/*", "!/hero/*", "!/og/*"]
	},
	// Production domain: aerocomfort.es (+ www, redirected by the Worker); aero.dimadomore.com
	// stays attached and redirects to aerocomfort.es.
	// The custom domain is attached at the account level via the Workers Domains API,
	// not declared here — the CI token has no zone-level Workers Routes permission.
	"workers_dev": false,
	// LEAD_EMAIL_FROM, LEAD_EMAIL_TO and TELEGRAM_CHAT_ID are plain variables set
	// in the Cloudflare dashboard. Without this, every `wrangler deploy` deletes
	// them and lead notifications stop without any error. Do NOT add them under
	// "vars" here: a value in this file overwrites the dashboard on every deploy.
	"keep_vars": true,
	// Preview URLs for `wrangler versions upload` (dev branch deploys)
	"preview_urls": true,
	// Lead storage (mini-CRM). The Worker writes each lead here and /leads reads
	// it. Local `wrangler dev` uses a local SQLite copy; apply the schema with:
	//   wrangler d1 migrations apply aerocomfort-leads --local   (and --remote for prod)
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "aerocomfort-leads",
			"database_id": "0f7286b3-9422-4d6b-99d2-56381adb9545",
			"migrations_dir": "migrations"
		}
	]
}
